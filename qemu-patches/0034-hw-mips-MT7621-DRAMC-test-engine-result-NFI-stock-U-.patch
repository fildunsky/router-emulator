From 0b9ea25df1ae2ecdb522959756ab4a3a949a7c2e Mon Sep 17 00:00:00 2001
From: Dmitry Mostovoy <stavultras@gmail.com>
Date: Sun, 18 Oct 2026 16:06:00 -0400
Subject: [PATCH 34/36] hw/mips: MT7621 DRAMC test-engine result + NFI
 stock-U-Boot support

DRAMC: the stock MediaTek stage1 (DQS gating + RX/TX per-bit) runs a
hardware memory test per delay step and reads the compare result on
DRAMC+0x3c0; report the golden 0x40404040 when a test is armed, so the
ideal DRAM yields a full pass window and calibration passes.

NFI: model NFI_INTR_STA (completed operations), a separate cumulative
ECC-decoder sector counter (reset on DECCON, not on every CNFG write),
and auto-load each sector's spare into the FDM registers on page load.
With these the stock Xiaomi Mi Router 3G U-Boot 1.1.3 inits the NAND,
identifies the chip and reaches its boot menu.
---
 hw/mips/mt7621.c      | 14 ++++++++++++++
 hw/mips/mt7621_nand.c | 19 ++++++++++++++++---
 2 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/hw/mips/mt7621.c b/hw/mips/mt7621.c
index 9f9a963..350fd25 100644
--- a/hw/mips/mt7621.c
+++ b/hw/mips/mt7621.c
@@ -297,6 +297,20 @@ static uint64_t palmbus_read(void *opaque, hwaddr addr, unsigned size)
     case MT7621_IPPC_BASE + 0x24:       /* IP_XHCI_CAP: 1 USB3 + 1 USB2 */
         v = 0x0101;
         break;
+    /*
+     * DRAMC software test engine (used by the stock stage1 for the RX/TX
+     * DQS calibration): a test is armed by setting bit 30 of DRAMC+0x08,
+     * polls "done" on DRAMC+0x3fc bit 10 (set above), then reads the
+     * per-byte compare result on DRAMC+0x3c0.  Our DRAM is ideal, so the
+     * test always passes: report the "all lanes matched" value the code
+     * compares against (golden 0x40404040), for any delay -> a full pass
+     * window.  Off the test it reads back the written value.
+     */
+    case 0x1e0053c0:
+        if (b->palm_regs[(0x5008) / 4] & 0x40000000) {
+            v = 0x40404040;
+        }
+        break;
     }
 
     qemu_log_mask(LOG_UNIMP, "mt7621: read  0x%08" HWADDR_PRIx " = 0x%08x\n",
diff --git a/hw/mips/mt7621_nand.c b/hw/mips/mt7621_nand.c
index 14dbd4d..3b75826 100644
--- a/hw/mips/mt7621_nand.c
+++ b/hw/mips/mt7621_nand.c
@@ -36,6 +36,8 @@
 #define NFI_PAGEFMT     0x004
 #define NFI_CON         0x008
 #define  CON_NFI_RST    BIT(1)
+#define NFI_INTR_EN     0x010
+#define NFI_INTR_STA    0x014
 #define NFI_CMD         0x020
 #define NFI_ADDRNOB     0x030
 #define NFI_COLADDR     0x034
@@ -88,7 +90,8 @@ struct MT7621NandState {
     uint32_t ecc[0x800 / 4];
     bool data_phase;
     uint32_t sec_pos;           /* byte index in the current sector */
-    uint32_t sec;               /* current sector */
+    uint32_t sec;               /* current sector (FDM, per CNFG op) */
+    uint32_t ecc_sec;           /* ECC decoder sector (per DECCON, cumulative) */
 
     /* chip */
     uint8_t cmd;
@@ -127,6 +130,11 @@ static void page_load(MT7621NandState *s, uint32_t page)
                     s->oob + (uint64_t)page * OOB_SIZE, c) : NULL;
         s->buf[c] = p ? *p : 0xff;
     }
+    /* the controller auto-loads each sector's spare into the FDM registers */
+    for (int n = 0; n < 4 && n < 8; n++) {
+        s->nfi[NFI_FDML(n) / 4] = ldl_le_p(&s->buf[n * (SECT + SPARE) + SECT]);
+        s->nfi[NFI_FDMM(n) / 4] = ldl_le_p(&s->buf[n * (SECT + SPARE) + SECT + 4]);
+    }
 }
 
 static ssize_t file_pwrite(int fd, const void *buf, size_t len, off_t off)
@@ -300,7 +308,8 @@ static void fmt_after_sector(MT7621NandState *s, bool rd)
             s->nfi[NFI_FDMM(s->sec) / 4] = ldl_le_p(spare + 4);
         }
         if (cnfg & CNFG_HW_ECC) {
-            s->ecc[ECC_DECDONE / 4] |= 1u << s->sec;
+            s->ecc[ECC_DECDONE / 4] |= 1u << (s->ecc_sec & 31);
+            s->ecc_sec++;
         }
     } else {
         memset(spare, 0xff, sizeof(spare));
@@ -337,7 +346,7 @@ static void nfi_write_byte(MT7621NandState *s, uint8_t v)
 static void nfi_reset(MT7621NandState *s)
 {
     s->data_phase = false;
-    s->sec = s->sec_pos = 0;
+    s->sec = s->sec_pos = s->ecc_sec = 0;
     s->nfi[NFI_STRDATA / 4] = 0;
 }
 
@@ -364,6 +373,9 @@ static uint64_t nfi_read(void *opaque, hwaddr a, unsigned size)
         return (MIN(s->sec, 15) << 12) | (s->sec_pos & 0x3ff);
     case NFI_MASTER_STA:
         return 0;
+    case NFI_INTR_STA:
+        /* operations complete instantly: every enabled interrupt is set */
+        return s->nfi[NFI_INTR_EN / 4];
     }
     v = s->nfi[(a & 0x7ff) / 4];
     return v >> ((a & 3) * 8);
@@ -455,6 +467,7 @@ static void ecc_write(void *opaque, hwaddr a, uint64_t val, unsigned size)
 
     if ((a & ~3) == ECC_DECCON) {
         s->ecc[ECC_DECDONE / 4] = 0;    /* decoder (re)started */
+        s->ecc_sec = 0;
     }
     s->ecc[(a & 0x7ff) / 4] = val;
 }
