+/* MT7988: the built-in switch's registers are memory mapped */
+static uint64_t swmmio_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return sw_reg_read(opaque, addr & ~3);
+}
+
+static void swmmio_write(void *opaque, hwaddr addr, uint64_t val,
+                         unsigned size)
+{
+    sw_reg_write(opaque, addr & ~3, val);
+}
+
+static const MemoryRegionOps swmmio_ops = {
+    .read = swmmio_read,
+    .write = swmmio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
