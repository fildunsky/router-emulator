+/*
+ * Cortex-A73 (MediaTek MT7988): an ARMv8.0 core like the A72, which it is
+ * modelled on; its own MIDR, and CPUACTLR_EL1 at its A73 encoding
+ * (S3_0_C15_C0_0, used by TF-A's errata workarounds).
+ */
+static const ARMCPRegInfo cortex_a73_cp_reginfo[] = {
+    { .name = "A73_CPUACTLR_EL1", .state = ARM_CP_STATE_AA64,
+      .opc0 = 3, .opc1 = 0, .crn = 15, .crm = 0, .opc2 = 0,
+      .access = PL1_RW, .type = ARM_CP_CONST, .resetvalue = 0 },
+};
+
+static void aarch64_a73_initfn(Object *obj)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+
+    aarch64_a72_initfn(obj);
+    cpu->dtb_compatible = "arm,cortex-a73";
+    cpu->midr = 0x410fd092;     /* r0p2 */
+    define_arm_cp_regs(cpu, cortex_a73_cp_reginfo);
+}
