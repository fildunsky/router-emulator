From a5685a109062cd4660273f6e21b51348e09af16b Mon Sep 17 00:00:00 2001
From: Dmitry Mostovoy <stavultras@gmail.com>
Date: Mon, 19 Oct 2026 08:40:12 -0400
Subject: [PATCH] target/mips, hw/mips/mt7621: poweroff / halt stop the
 emulator

A board hook for a WAIT that nothing can end (Status.IE and all IM bits
clear), as Linux's machine_hang() after "poweroff" or "halt" does: the
MT7621 cannot switch itself off.  The machine then stops the emulator;
machine option poweroff=halt keeps the hardware behaviour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012GbUcwR34gg9RgGTEtNN6J
---
 hw/mips/mt7621.c            | 42 +++++++++++++++++++++++++++++++++++++
 target/mips/cpu.h           |  5 +++++
 target/mips/tcg/exception.c |  5 +++++
 3 files changed, 52 insertions(+)

diff --git a/hw/mips/mt7621.c b/hw/mips/mt7621.c
index 5572222..ad09a05 100644
--- a/hw/mips/mt7621.c
+++ b/hw/mips/mt7621.c
@@ -244,6 +244,7 @@ typedef struct MT7621Board {
     uint32_t l2_page[L2_OVL_PAGES];     /* DRAM page of each overlay page */
     int l2_npages;
     bool dcache_model;          /* dcache=on: model of the L1 D-cache */
+    bool poweroff_halt;         /* poweroff=halt: stay halted (hardware) */
     DCacheLine dcache[DC_SETS][DC_WAYS];        /* dirty L1 data lines */
     uint32_t dc_clock;
     MemoryRegion dram_alias[16];
@@ -487,6 +488,23 @@ static DCacheLine *dc_find(MT7621Board *b, target_ulong addr)
     return NULL;
 }
 
+/*
+ * The MT7621 cannot switch itself off: after "poweroff" (or "halt") Linux
+ * prints "reboot: Power down" and parks the CPU in a WAIT that nothing can
+ * end.  An emulator stops instead (poweroff=halt keeps the hardware
+ * behaviour).
+ */
+static void mt7621_dead_wait(CPUMIPSState *env)
+{
+    MT7621Board *b = the_board;
+
+    if (!b->poweroff_halt) {
+        info_report("poweroff: stopping the emulator "
+                    "(poweroff=halt to stay halted like the hardware)");
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    }
+}
+
 static void mt7621_store_hook(CPUMIPSState *env, target_ulong addr)
 {
     MT7621Board *b = the_board;
@@ -1008,6 +1026,7 @@ static void mt7621_init(MachineState *machine)
     CPU_FOREACH(cs) {
         cpu_env(cs)->cache_hook = mt7621_cache_hook;
         cpu_env(cs)->kseg0_remap = mt7621_kseg0_remap;
+        cpu_env(cs)->dead_wait_hook = mt7621_dead_wait;
         if (b->dcache_model) {
             cpu_env(cs)->store_hook = mt7621_store_hook;
         }
@@ -1092,6 +1111,24 @@ static void mt7621_set_flash(Object *obj, const char *v, Error **errp)
     }
 }
 
+static char *mt7621_get_poweroff(Object *obj, Error **errp)
+{
+    return g_strdup(MT7621_MACHINE(obj)->b.poweroff_halt ? "halt" : "stop");
+}
+
+static void mt7621_set_poweroff(Object *obj, const char *v, Error **errp)
+{
+    MT7621MachineState *ms = MT7621_MACHINE(obj);
+
+    if (!strcmp(v, "stop")) {
+        ms->b.poweroff_halt = false;
+    } else if (!strcmp(v, "halt")) {
+        ms->b.poweroff_halt = true;
+    } else {
+        error_setg(errp, "poweroff must be stop or halt");
+    }
+}
+
 static bool mt7621_get_dcache(Object *obj, Error **errp)
 {
     return MT7621_MACHINE(obj)->b.dcache_model;
@@ -1315,6 +1352,11 @@ static void mt7621_machine_class_init(ObjectClass *oc, const void *data)
     object_class_property_set_description(oc, "flash",
         "Boot flash: nor (SPI-NOR, default) or nand (parallel NAND on the "
         "NFI, 128 MB)");
+    object_class_property_add_str(oc, "poweroff", mt7621_get_poweroff,
+                                  mt7621_set_poweroff);
+    object_class_property_set_description(oc, "poweroff",
+        "On poweroff / halt: stop (end the emulator, default) or halt (stay "
+        "halted, as the MT7621 itself does)");
     object_class_property_add_bool(oc, "dcache", mt7621_get_dcache,
                                    mt7621_set_dcache);
     object_class_property_set_description(oc, "dcache",
diff --git a/target/mips/cpu.h b/target/mips/cpu.h
index 2d15b26..58c7bdc 100644
--- a/target/mips/cpu.h
+++ b/target/mips/cpu.h
@@ -1210,6 +1210,11 @@ typedef struct CPUArchState {
      * it, it flushes the translations.
      */
     void (*store_hook)(struct CPUArchState *env, target_ulong addr);
+    /*
+     * Board hook: a WAIT that nothing can end (Status.IE and all IM bits
+     * clear), e.g. Linux's machine_hang() after "poweroff" or "halt"
+     */
+    void (*dead_wait_hook)(struct CPUArchState *env);
 
     /* Loongson IOCSR memory */
     struct {
diff --git a/target/mips/tcg/exception.c b/target/mips/tcg/exception.c
index d32bceb..9ab3332 100644
--- a/target/mips/tcg/exception.c
+++ b/target/mips/tcg/exception.c
@@ -68,6 +68,11 @@ void helper_wait(CPUMIPSState *env)
 {
     CPUState *cs = env_cpu(env);
 
+    if (env->dead_wait_hook &&
+        !(env->CP0_Status & ((1 << CP0St_IE) | (0xff << CP0St_IM)))) {
+        env->dead_wait_hook(env);
+    }
+
     cs->halted = 1;
     cpu_reset_interrupt(cs, CPU_INTERRUPT_WAKE);
     /*
-- 
