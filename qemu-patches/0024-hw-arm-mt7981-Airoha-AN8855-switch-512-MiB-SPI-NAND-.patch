+/* ------------------------------------------------------------------ */
+/* Airoha AN8855 switch                                               */
+
+/*
+ * The AN8855 is modelled on top of the MT7531 one: its port, VLAN and
+ * address table registers are translated into the MT7531 register file
+ * that the forwarding code reads.  Its CPU port is 5 (MT7531: 6); user
+ * ports 0..4 are the internal PHYs at MDIO addresses switch-addr + 0..4.
+ * Registers without a function here are plain storage at their own
+ * (0x10xxxxxx) addresses, so they cannot collide with the MT7531 ones.
+ */
+#define AN_CREV         0x10005000
+#define AN_RST_CTRL     0x100050c0
+#define AN_HWTRAP       0x1000009c
+#define AN_PKG_SEL      0x10000094
+#define AN_ATC          0x10200300
+#define AN_VTCR         0x10200600
+#define AN_VAWD0        0x10200604
+#define AN_VARD0        0x10200618
+#define AN_PORT(a)      (((a) - 0x10208000) / 0x200)
+#define AN_PMSR(p)      (0x10210010 + (p) * 0x200)
+
+/* AN8855 port number <-> port of the MT7531 model (CPU 5 <-> 6) */
+static int an_port(int p)
+{
+    return p == 5 ? SW_CPU_PORT : p;
+}
+
+static uint32_t an_mask_to_sw(uint32_t m)
+{
+    return (m & 0x1f) | ((m & BIT(5)) ? BIT(SW_CPU_PORT) : 0);
+}
+
+static void an_reset(MT7981EthState *s)
+{
+    g_hash_table_remove_all(s->sw);
+    memset(s->fdb, 0, sizeof(s->fdb));
+}
+
+static uint32_t an_reg_read(MT7981EthState *s, uint32_t a)
+{
+    a &= ~3u;
+    switch (a) {
+    case AN_CREV:
+        return 0x8855;
+    case AN_HWTRAP:             /* nonzero: the switch has initialised */
+        return ht_get(s->sw, a, 0x1);
+    case AN_PKG_SEL:            /* AN8855H */
+        return ht_get(s->sw, a, 0x2);
+    case AN_RST_CTRL:
+        return ht_get(s->sw, a, 0) & ~BIT(31);
+    case AN_ATC:                /* done; searches find nothing (HIT 0) */
+        return ht_get(s->sw, a, 0) & ~(BIT(31) | (0xf << 12));
+    case AN_VTCR:
+        return ht_get(s->sw, a, 0) & ~BIT(31);
+    }
+    if (a >= 0x10210000 && a < 0x10210000 + 6 * 0x200 &&
+        (a & 0x1ff) == 0x10) {
+        /* PMSR: link, full duplex, 1000M (user ports) / 2500M (CPU) */
+        int p = (a - 0x10210000) / 0x200;
+        bool lnk = p == 5 || (p < SW_NPHY && s->gphy[p].link);
+        return lnk ? (BIT(24) | BIT(25) | ((p == 5 ? 3u : 2u) << 28) |
+                      BIT(4) | BIT(5)) : 0;
+    }
+    return ht_get(s->sw, a, 0);
+}
+
+static void an_reg_write(MT7981EthState *s, uint32_t a, uint32_t v)
+{
+    a &= ~3u;
+    if (a == AN_RST_CTRL && (v & BIT(31))) {
+        an_reset(s);            /* switch soft reset, self clearing */
+        return;
+    }
+    ht_set(s->sw, a, v);
+    if (a >= 0x10208000 && a < 0x10208000 + 6 * 0x200) {
+        int p = an_port(AN_PORT(a));
+        uint32_t pcr = ht_get(s->sw, SW_PCR(p), 0x00ff0000);
+        switch (a & 0x1ff) {
+        case 0x04:              /* PCR: [1:0] port VLAN mode */
+            ht_set(s->sw, SW_PCR(p), (pcr & ~3u) | (v & 3));
+            break;
+        case 0x10:              /* PVC: [5] special tag */
+            ht_set(s->sw, SW_PVC(p), v);
+            break;
+        case 0x44:              /* PORTMATRIX */
+            ht_set(s->sw, SW_PCR(p), (pcr & ~0x00ff0000u) |
+                   an_mask_to_sw(v & 0x3f) << 16);
+            break;
+        case 0x48:              /* PVID */
+            ht_set(s->sw, SW_PPBV1(p), v & 0xfff);
+            break;
+        }
+        return;
+    }
+    switch (a) {
+    case AN_ATC:
+        if ((v & BIT(31)) && (v & 7) == 2) {    /* flush */
+            memset(s->fdb, 0, sizeof(s->fdb));
+        }
+        break;
+    case AN_VTCR:
+        if (v & BIT(31)) {
+            uint32_t vid = v & 0xfff, func = (v >> 12) & 0xf;
+            if (func == 1) {            /* write VAWD0 into the table */
+                uint32_t w = ht_get(s->sw, AN_VAWD0, 0), etag = 0;
+                for (int p = 0; p < 6; p++) {
+                    etag |= ((w >> (12 + 2 * p)) & 3) << (2 * an_port(p));
+                }
+                ht_set(s->sw, 0x100000 | vid,
+                       an_mask_to_sw(w >> 26) << 16 | (w & 1) |
+                       ((w & BIT(10)) ? VAWD1_VTAG_EN : 0));
+                ht_set(s->sw, 0x200000 | vid, etag);
+                ht_set(s->sw, 0x300000 | vid, w);   /* as written */
+            } else if (func == 0) {     /* read into VARD0 */
+                ht_set(s->sw, AN_VARD0, ht_get(s->sw, 0x300000 | vid, 0));
+            }
+        }
+        break;
+    }
+}
+
+/*
+ * MDIO on the AN8855 addresses: page 4 (register 0x1f) on switch-addr
+ * selects the 32-bit "PBUS" (0x10 mode, 0x11/0x12 write address,
+ * 0x13/0x14 write data, 0x15/0x16 read address, 0x17/0x18 read data);
+ * any other page there, and the other addresses, reach the PHYs.
+ */
+static bool an_mdio(MT7981EthState *s, int addr, int reg, bool wr,
+                    uint16_t *val)
+{
+    int i = (addr - (int)s->switch_addr) & 0x1f;
+    EthPhy *p;
+
+    if (s->switch_model != 1 || !s->has_switch || i >= SW_NPHY) {
+        return false;
+    }
+    p = &s->gphy[i];
+    if (i == 0 && p->page == 4 && reg != 0x1f) {
+        switch (reg) {
+        case 0x11: if (wr) s->an_wr_addr = (s->an_wr_addr & 0xffff) | *val << 16; break;
+        case 0x12: if (wr) s->an_wr_addr = (s->an_wr_addr & ~0xffffu) | *val; break;
+        case 0x13: if (wr) s->an_wr_hi = *val; break;
+        case 0x14:              /* low data half: the write happens */
+            if (wr) {
+                an_reg_write(s, s->an_wr_addr, s->an_wr_hi << 16 | *val);
+            }
+            break;
+        case 0x15:
+            if (wr) {
+                s->an_rd_addr = (s->an_rd_addr & 0xffff) | (uint32_t)*val << 16;
+            }
+            break;
+        case 0x16:              /* read address complete: read now */
+            if (wr) {
+                s->an_rd_addr = (s->an_rd_addr & ~0xffffu) | *val;
+                s->an_rd_val = an_reg_read(s, s->an_rd_addr);
+            }
+            break;
+        case 0x17: if (!wr) *val = s->an_rd_val >> 16; break;
+        case 0x18: if (!wr) *val = s->an_rd_val & 0xffff; break;
+        default:
+            if (!wr) *val = 0;
+            break;
+        }
+        return true;
+    }
+    if (wr) {
+        phy_c22_write(p, reg, *val);
+    } else {
+        *val = phy_c22_read(p, reg);
+    }
+    return true;
+}
+
