diff --git a/hw/arm/filogic/mtk_pinctrl.c b/hw/arm/filogic/mtk_pinctrl.c
index 66c9898..46ad6c4 100644
--- a/hw/arm/filogic/mtk_pinctrl.c
+++ b/hw/arm/filogic/mtk_pinctrl.c
@@ -2,6 +2,10 @@
  * MT7981 / MT7986 GPIO controller + external interrupt (EINT) controller
  * (57 pins on MT7981, 101 on MT7986, same register layout).
  *
+ * With mt7621=on: the MT7621 GPIO block (3 banks of 32 pins, CTRL, POL,
+ * DATA, DSET, DCLR, edge / level interrupt enables and status, one
+ * interrupt line), no EINT block.
+ *
  * GPIO inputs are driven by board level signals (buttons, the MT7531
  * interrupt line).  Buttons can be pressed from the monitor:
  *   qom-set /machine/soc/pinctrl reset-button true
@@ -47,6 +51,11 @@ struct MtkPinctrlState {
     uint32_t reset_hold_ms;     /* hold reset from power on (TFTP recovery) */
     QEMUTimer *reset_release;
     bool gpio_log;
+
+    /* MT7621 layout */
+    bool mt7621;
+    uint32_t m_pol[3], m_redge[3], m_fedge[3], m_hlvl[3], m_llvl[3];
+    uint32_t m_stat[3];
 };
 
 static bool pin_level(MtkPinctrlState *s, int pin)
@@ -98,6 +107,21 @@ static void eint_update(MtkPinctrlState *s)
 {
     bool level = false;
 
+    if (s->mt7621) {
+        for (int w = 0; w < 3; w++) {
+            for (int b = 0; b < 32; b++) {
+                bool lvl = pin_level(s, w * 32 + b);
+                if ((s->m_hlvl[w] & BIT(b) && lvl) ||
+                    (s->m_llvl[w] & BIT(b) && !lvl)) {
+                    s->m_stat[w] |= BIT(b);
+                }
+            }
+            level |= s->m_stat[w] != 0;
+        }
+        qemu_set_irq(s->irq, level);
+        return;
+    }
+
     for (int p = 0; p < EINT_PORTS; p++) {
         for (int b = 0; b < 32; b++) {
             int pin = p * 32 + b;
@@ -125,6 +149,15 @@ static void set_input(MtkPinctrlState *s, int pin, bool level)
     } else {
         s->ext_level[w] &= ~BIT(b);
     }
+    if (s->mt7621) {
+        if (old != level &&
+            ((level && (s->m_redge[w] & BIT(b))) ||
+             (!level && (s->m_fedge[w] & BIT(b))))) {
+            s->m_stat[w] |= BIT(b);
+        }
+        eint_update(s);
+        return;
+    }
     /* edge detection for edge sensitive EINTs */
     if (old != level && !(s->e_sens[p] & BIT(b))) {
         bool pol = s->e_pol[p] & BIT(b);
@@ -153,11 +186,78 @@ static uint32_t *gpio_reg(MtkPinctrlState *s, hwaddr a)
     return NULL;
 }
 
+/*
+ * MT7621: 0x00 CTRL (1 = output), 0x10 POL, 0x20 DATA, 0x30 DSET,
+ * 0x40 DCLR, 0x50 REDGE, 0x60 FEDGE, 0x70 HLVL, 0x80 LLVL, 0x90 STAT
+ * (write 1 to clear), 0xa0 EDGE; + 4 * bank
+ */
+static uint32_t *m7621_reg(MtkPinctrlState *s, hwaddr a)
+{
+    int w = (a & 0xf) / 4;
+
+    if (w > 2) {
+        return NULL;
+    }
+    switch (a & 0xff0) {
+    case 0x00: return &s->dir[w];
+    case 0x10: return &s->m_pol[w];
+    case 0x50: return &s->m_redge[w];
+    case 0x60: return &s->m_fedge[w];
+    case 0x70: return &s->m_hlvl[w];
+    case 0x80: return &s->m_llvl[w];
+    case 0x90: case 0xa0: return &s->m_stat[w];
+    }
+    return NULL;
+}
+
+static uint64_t m7621_read(MtkPinctrlState *s, hwaddr a)
+{
+    int w = (a & 0xf) / 4;
+    uint32_t *r;
+
+    if ((a & 0xff0) == 0x20 && w < 3) {
+        uint32_t v = 0;
+        for (int b = 0; b < 32; b++) {
+            if (w * 32 + b < s->npins && pin_level(s, w * 32 + b)) {
+                v |= BIT(b);
+            }
+        }
+        return v;
+    }
+    r = m7621_reg(s, a);
+    return r ? *r : 0;
+}
+
+static void m7621_write(MtkPinctrlState *s, hwaddr a, uint32_t val)
+{
+    int w = (a & 0xf) / 4;
+    uint32_t *r;
+
+    if (w > 2) {
+        return;
+    }
+    switch (a & 0xff0) {
+    case 0x20: s->dout[w] = val; break;
+    case 0x30: s->dout[w] |= val; break;
+    case 0x40: s->dout[w] &= ~val; break;
+    case 0x90: case 0xa0: s->m_stat[w] &= ~val; break;
+    default:
+        r = m7621_reg(s, a);
+        if (r) {
+            *r = val;
+        }
+    }
+}
+
 static uint64_t gpio_read(void *opaque, hwaddr a, unsigned size)
 {
     MtkPinctrlState *s = opaque;
     uint32_t *r;
 
+    if (s->mt7621) {
+        return m7621_read(s, a);
+    }
+
     if (a == 0x6f0) {
         return s->bootstrap;
     }
@@ -178,10 +278,10 @@ static uint64_t gpio_read(void *opaque, hwaddr a, unsigned size)
 static void gpio_write(void *opaque, hwaddr a, uint64_t val, unsigned size)
 {
     MtkPinctrlState *s = opaque;
-    uint32_t *r = gpio_reg(s, a);
+    uint32_t *r = s->mt7621 ? NULL : gpio_reg(s, a);
     uint32_t old_out[NWORDS];
 
-    if (!r) {
+    if (!r && !s->mt7621) {
         return;
     }
     for (int w = 0; w < NWORDS; w++) {
@@ -192,10 +292,14 @@ static void gpio_write(void *opaque, hwaddr a, uint64_t val, unsigned size)
             }
         }
     }
-    switch (a & 0xf) {
-    case 0x0: *r = val; break;
-    case 0x4: *r |= val; break;
-    case 0x8: *r &= ~val; break;
+    if (s->mt7621) {
+        m7621_write(s, a, val);
+    } else {
+        switch (a & 0xf) {
+        case 0x0: *r = val; break;
+        case 0x4: *r |= val; break;
+        case 0x8: *r &= ~val; break;
+        }
     }
     if (s->gpio_log) {
         for (int w = 0; w < NWORDS; w++) {
@@ -288,6 +392,12 @@ static void pinctrl_reset(DeviceState *dev)
     memset(s->e_pol, 0, sizeof(s->e_pol));
     memset(s->e_dom, 0, sizeof(s->e_dom));
     memset(s->e_other, 0, sizeof(s->e_other));
+    memset(s->m_pol, 0, sizeof(s->m_pol));
+    memset(s->m_redge, 0, sizeof(s->m_redge));
+    memset(s->m_fedge, 0, sizeof(s->m_fedge));
+    memset(s->m_hlvl, 0, sizeof(s->m_hlvl));
+    memset(s->m_llvl, 0, sizeof(s->m_llvl));
+    memset(s->m_stat, 0, sizeof(s->m_stat));
     for (int p = 0; p < EINT_PORTS; p++) {
         s->e_mask[p] = 0xffffffff;
     }
@@ -428,6 +538,7 @@ static const Property pinctrl_props[] = {
     DEFINE_PROP_UINT32("reset-hold", MtkPinctrlState, reset_hold_ms, 0),
     DEFINE_PROP_BOOL("reset-active-high", MtkPinctrlState, reset_active_high, false),
     DEFINE_PROP_BOOL("wps-active-high", MtkPinctrlState, wps_active_high, false),
+    DEFINE_PROP_BOOL("mt7621", MtkPinctrlState, mt7621, false),
 };
 
