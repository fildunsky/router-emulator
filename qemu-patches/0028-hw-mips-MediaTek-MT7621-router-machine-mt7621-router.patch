+static char *mt7621_get_usb(Object *obj, Error **errp)
+{
+    uint32_t u = MT7621_MACHINE(obj)->b.usb;
+
+    return g_strdup(u == 0 ? "none" : u == 2 ? "2" : "3");
+}
+
+static void mt7621_set_usb(Object *obj, const char *v, Error **errp)
+{
+    MT7621MachineState *ms = MT7621_MACHINE(obj);
+
+    if (!strcmp(v, "none")) {
+        ms->b.usb = 0;
+    } else if (!strcmp(v, "2") || !strcmp(v, "3")) {
+        ms->b.usb = *v - '0';
+    } else {
+        error_setg(errp, "usb-port must be none, 2 or 3");
+    }
+}
