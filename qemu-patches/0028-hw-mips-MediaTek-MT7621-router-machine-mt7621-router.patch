+static void mt7621_set_led(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    MT7621Board *b = &MT7621_MACHINE(obj)->b;
+    char *value;
+
+    if (visit_type_str(v, name, &value, errp)) {
+        g_free(b->led_def[(uintptr_t)opaque]);
+        b->led_def[(uintptr_t)opaque] = value;
+    }
+}
