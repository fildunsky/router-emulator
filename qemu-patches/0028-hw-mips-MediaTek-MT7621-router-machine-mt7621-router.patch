+{
+    MT7621MachineState *ms = MT7621_MACHINE(obj);
+
+    g_free(ms->b.ports);
+    ms->b.ports = g_strdup(v);
+}
+
+static bool mt7621_get_gpio_log(Object *obj, Error **errp)
+{
+    return MT7621_MACHINE(obj)->b.gpio_log;
