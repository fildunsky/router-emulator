+        return;
+    }
+    if (addr >= s->qdma_base && addr < s->qdma_base + 0x400) {
+        addr = addr - s->qdma_base + 0x4400;    /* the NETSYS layout */
+    } else if (addr >= 0x4000 && addr < 0x4800 && s->qdma_base != 0x4400) {
+        ht_set(s->fe, addr, v);
         return;
     }
