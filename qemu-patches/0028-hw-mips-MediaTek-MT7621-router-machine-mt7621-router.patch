+static void mt7621_instance_init(Object *obj)
+{
+    MT7621_MACHINE(obj)->b.reset_gpio = 18;
+    MT7621_MACHINE(obj)->b.wps_gpio = 95;     /* none: an unused pin */
+    MT7621_MACHINE(obj)->b.ddr = 3;
+    MT7621_MACHINE(obj)->b.usb = 3;
+}
+
+static void mt7621_machine_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "MediaTek MT7621 router board";
+    mc->init = mt7621_init;
+    mc->default_cpu_type = MIPS_CPU_TYPE_NAME("1004Kc");
+    mc->default_ram_size = 256 * MiB;
+    mc->default_ram_id = "mt7621.dram";
+    mc->max_cpus = 4;
+    mc->default_cpus = 1;
+
+    object_class_property_add_str(oc, "nand-dir", mt7621_get_flash_dir,
+                                  mt7621_set_flash_dir);
+    object_class_property_set_description(oc, "nand-dir",
+        "SPI-NOR flash: folder of partition dumps (files named *mtdN*)");
+    object_class_property_add_str(oc, "ports", mt7621_get_ports,
+                                  mt7621_set_ports);
+    object_class_property_set_description(oc, "ports",
+        "netdev ids of MT7530 ports 0..4, ':' separated (- = unconnected)");
+    object_class_property_add_bool(oc, "gpio-log", mt7621_get_gpio_log,
+                                   mt7621_set_gpio_log);
+    object_class_property_set_description(oc, "gpio-log",
+        "Print GPIO output changes and LED states");
+    object_class_property_add(oc, "reset-hold", "uint32",
+                              mt7621_get_reset_hold, mt7621_set_reset_hold,
+                              NULL, NULL);
+    object_class_property_set_description(oc, "reset-hold",
+        "Power on with the reset button held for this many ms");
+    object_class_property_add(oc, "reset-gpio", "uint32", mt7621_get_u32,
+                              mt7621_set_u32, NULL,
+                              (void *)offsetof(MT7621Board, reset_gpio));
+    object_class_property_set_description(oc, "reset-gpio",
+        "GPIO of the reset button (default 18)");
+    object_class_property_add(oc, "wps-gpio", "uint32", mt7621_get_u32,
+                              mt7621_set_u32, NULL,
+                              (void *)offsetof(MT7621Board, wps_gpio));
+    object_class_property_set_description(oc, "wps-gpio",
+        "GPIO of the WPS button (default: none)");
+    object_class_property_add_bool(oc, "reset-active-high",
+                                   mt7621_get_reset_high,
+                                   mt7621_set_reset_high);
+    object_class_property_add_bool(oc, "wps-active-high",
+                                   mt7621_get_wps_high, mt7621_set_wps_high);
+    for (int i = 0; i < MAX_LEDS; i++) {
+        g_autofree char *name = g_strdup_printf("led%d", i + 1);
+        object_class_property_add(oc, name, "str", mt7621_get_led,
+                                  mt7621_set_led, NULL, (void *)(uintptr_t)i);
+        object_class_property_set_description(oc, name,
+            "front panel LED: \"<name>: <colour> gpio:N[:low][ + ...]\"");
+    }
+    object_class_property_add_str(oc, "led-state", mt7621_get_led_state,
+                                  NULL);
+    object_class_property_set_description(oc, "led-state",
+        "LED states, ';' per LED, ',' per colour: 0, 1, b (blinking)");
+    object_class_property_add_str(oc, "usb-host", mt7621_get_usb_host,
+                                  mt7621_set_usb_host);
+    object_class_property_set_description(oc, "usb-host",
+        "Host USB devices passed through, VID:PID[;VID:PID...]");
+    object_class_property_add_str(oc, "usb-port", mt7621_get_usb,
+                                  mt7621_set_usb);
+    object_class_property_set_description(oc, "usb-port",
+        "Board USB connector: 3 (USB 3.0, default), 2 (USB 2.0) or none");
+    object_class_property_add_str(oc, "ddr", mt7621_get_ddr, mt7621_set_ddr);
+    object_class_property_set_description(oc, "ddr",
+        "DRAM type strap: ddr2 or ddr3 (default)");
+}
+
+static const TypeInfo mt7621_machine_type = {
+    .name = TYPE_MT7621_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(MT7621MachineState),
+    .instance_init = mt7621_instance_init,
+    .class_init = mt7621_machine_class_init,
+};
+
+static void mt7621_machine_register(void)
+{
+    type_register_static(&mt7621_spi_type);
+    type_register_static(&mt7621_machine_type);
+}
+
+type_init(mt7621_machine_register)
