@@ -2172,6 +2209,8 @@ static void eth_reset(DeviceState *dev)
                  port_link(s, i));
         if (s->switch_model == 2) {
             s->gphy[i].c22[MII_PHYID2] = 0x9481;
+        } else if (s->switch_model == 3) {
+            s->gphy[i].c22[MII_PHYID2] = 0x9412;    /* MT7530 GPHY */
         }
     }
     for (int g = 0; g < 2; g++) {
@@ -2283,11 +2322,15 @@ static const Property eth_props[] = {
     DEFINE_PROP_UINT32("switch-addr", MtkEthState, switch_addr, 31),
     /*
      * 0 = MediaTek MT7531, 1 = Airoha AN8855 (CPU port 5, PBUS access),
