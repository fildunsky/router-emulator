index 0000000..6139181
--- /dev/null
+++ b/hw/mips/mt7621.c
@@ -0,0 +1,862 @@
+/*
+ * MediaTek MT7621 router board (mt7621-router)
+ *
+ * MIPS 1004Kc with the MIPS Coherent Processing System (CM GCR, CPC,
+ * GIC), DRAM at 0 with address wrap-around like the real memory
+ * controller, the palmbus peripherals at 0x1e000000 and the SPI-NOR
+ * flash memory-mapped at 0x1fc00000 (the reset vector), so the boot
+ * chain runs from the flash like on a real board: TPL (from the flash)
+ * -> SPL in L2 cache locked as SRAM -> MediaTek DDR init blob in the
+ * Frame Engine SRAM -> U-Boot -> OpenWrt.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/boards.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-clock.h"
+#include "hw/qdev-properties.h"
+#include "hw/char/serial-mm.h"
+#include "hw/usb/xhci.h"
+#include "hw/usb/hcd-xhci-sysbus.h"
+#include "hw/irq.h"
+#include "hw/ssi/ssi.h"
+#include "hw/qdev-properties-system.h"
+#include "net/net.h"
+#include "system/block-backend.h"
+#include "system/blockdev.h"
+#include "../arm/filogic/filogic.h"
+#include "../arm/filogic/filogic_leds.h"
+#include "hw/mips/cps.h"
+#include "hw/timer/mips_gictimer.h"
+#include "hw/mips/mips.h"
+#include "system/system.h"
+#include "system/address-spaces.h"
+#include "system/reset.h"
+#include "system/runstate.h"
+#include "target/mips/cpu.h"
+
+#define MT7621_LOWMEM_MAX       0x1c000000ULL   /* DRAM below the I/O space */
+#define MT7621_HIGHMEM_BASE     0x20000000ULL   /* DRAM above 448 MB */
+#define MT7621_PALMBUS_BASE     ((hwaddr)0x1e000000)
+#define MT7621_PALMBUS_SIZE     0x00200000ULL
+#define MT7621_SYSCTL_BASE      0x1e000000ULL
+#define MT7621_GPIO_BASE        0x1e000600ULL
+#define MT7621_UART0_BASE       0x1e000c00ULL
+#define MT7621_SPI_BASE         0x1e000b00ULL
+#define MT7621_XHCI_BASE        0x1e1c0000ULL
+#define MT7621_IPPC_BASE        0x1e1d0700ULL   /* SSUSB IP port control */
+#define MT7621_FE_BASE          0x1e100000ULL   /* frame engine, GMAC */
+#define MT7621_FE_SRAM_BASE     0x1e108000ULL   /* PSE SRAM of the FE */
+#define MT7621_FE_SRAM_SIZE     0x6000
+#define MT7621_FLASH_MMAP_BASE  0x1fc00000ULL
+#define MT7621_FLASH_MMAP_SIZE  0x00400000ULL
+
+#define MT7621_CPU_HZ           880000000
+#define MAX_LEDS                32
+
+/* GIC shared interrupts */
+#define MT7621_IRQ_FE           3
+#define MT7621_IRQ_GPIO         12
+#define MT7621_IRQ_XHCI         22
+#define MT7621_IRQ_SWITCH       23
+#define MT7621_IRQ_UART0        26
+
+/* sysctl registers */
+#define SYSC_CHIP_NAME0         0x00
+#define SYSC_CHIP_NAME1         0x04
+#define SYSC_CHIP_REV           0x0c
+#define SYSC_SYSCFG0            0x10
+#define SYSC_CLKCFG0            0x2c
+#define SYSC_RSTCTL             0x34
+#define SYSC_CUR_CLK_STS        0x44
+
+/*
+ * SPI controller in "more buffer" mode, as the U-Boot and Linux drivers
+ * use it: OPCODE holds up to 4 command bytes (MSB first), DATA0..7 up to
+ * 32 bytes out or in (LSB first), MOREBUF the bit counts; TRANS bit 8
+ * starts the transfer, which completes at once.  Chip select: POLAR.
+ */
+#define TYPE_MT7621_SPI "mt7621-spi"
+OBJECT_DECLARE_SIMPLE_TYPE(MT7621SpiState, MT7621_SPI)
+
+#define SPI_TRANS       0x00
+#define SPI_OPCODE      0x04
+#define SPI_DATA0       0x08
+#define SPI_MASTER      0x28
+#define SPI_MOREBUF     0x2c
+#define SPI_POLAR       0x38
+#define SPI_NREGS       (0x100 / 4)
+
+struct MT7621SpiState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    SSIBus *bus;
+    qemu_irq cs[2];
+    uint32_t regs[SPI_NREGS];
+};
+
+static void mt7621_spi_xfer(MT7621SpiState *s)
+{
+    uint32_t mb = s->regs[SPI_MOREBUF / 4];
+    unsigned cmd = ((mb >> 24) & 0x3f) / 8;
+    unsigned mosi = (mb & 0x1ff) / 8;
+    unsigned miso = ((mb >> 12) & 0x1ff) / 8;
+    uint8_t *data = (uint8_t *)&s->regs[SPI_DATA0 / 4];
+
+    if (!(s->regs[SPI_MASTER / 4] & 4)) {
+        return;         /* legacy mode: only used to idle the bus */
+    }
+    cmd = MIN(cmd, 4);
+    mosi = MIN(mosi, 32);
+    miso = MIN(miso, 32);
+    for (unsigned i = 0; i < cmd; i++) {
+        ssi_transfer(s->bus, (s->regs[SPI_OPCODE / 4] >> (8 * (cmd - 1 - i)))
+                             & 0xff);
+    }
+    for (unsigned i = 0; i < mosi; i++) {
+        ssi_transfer(s->bus, data[i ^ (HOST_BIG_ENDIAN ? 3 : 0)]);
+    }
+    for (unsigned i = 0; i < miso; i++) {
+        data[i ^ (HOST_BIG_ENDIAN ? 3 : 0)] = ssi_transfer(s->bus, 0);
+    }
+}
+
+static uint64_t mt7621_spi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    MT7621SpiState *s = opaque;
+
+    return s->regs[addr / 4];
+}
+
+static void mt7621_spi_write(void *opaque, hwaddr addr, uint64_t val,
+                             unsigned size)
+{
+    MT7621SpiState *s = opaque;
+
+    switch (addr) {
+    case SPI_TRANS:
+        s->regs[0] = val & ~((1u << 8) | (1u << 16));   /* never busy */
+        if (val & (1u << 8)) {
+            mt7621_spi_xfer(s);
+        }
+        return;
+    case SPI_POLAR:
+        for (int i = 0; i < 2; i++) {
+            /* SSI chip selects are active low */
+            qemu_set_irq(s->cs[i], !(val & (1u << i)));
+        }
+        break;
+    }
+    s->regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps mt7621_spi_ops = {
+    .read = mt7621_spi_read,
+    .write = mt7621_spi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void mt7621_spi_reset(DeviceState *dev)
+{
+    MT7621SpiState *s = MT7621_SPI(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    for (int i = 0; i < 2; i++) {
+        qemu_set_irq(s->cs[i], 1);
+    }
+}
+
+static void mt7621_spi_init(Object *obj)
+{
+    MT7621SpiState *s = MT7621_SPI(obj);
+
+    memory_region_init_io(&s->iomem, obj, &mt7621_spi_ops, s, "mt7621-spi",
+                          0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->bus = ssi_create_bus(DEVICE(obj), "spi");
+    for (int i = 0; i < 2; i++) {
+        sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->cs[i]);
+    }
+}
+
+static void mt7621_spi_class_init(ObjectClass *oc, const void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(oc), mt7621_spi_reset);
+}
+
+static const TypeInfo mt7621_spi_type = {
+    .name = TYPE_MT7621_SPI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MT7621SpiState),
+    .instance_init = mt7621_spi_init,
+    .class_init = mt7621_spi_class_init,
+};
+
+typedef struct MT7621Board {
+    MachineState *machine;
+    MIPSCPSState cps;
+    Clock *cpuclk;
+
+    MemoryRegion palmbus;       /* catch-all register file, lowest prio */
+    uint32_t palm_regs[MT7621_PALMBUS_SIZE / 4];
+    MemoryRegion fe_sram;
+    MemoryRegion dram_alias[16];
+    MemoryRegion lowmem;
+    MemoryRegion highmem;
+    MemoryRegion flash_mmap;
+
+    DeviceState *spi;
+    SpiNorState *nor;
+
+    DeviceState *eth;
+    DeviceState *pinctrl;
+    MemoryRegion gpio_alias;
+    RouterLeds *leds;
+
+    /* properties */
+    char *flash_dir;
+    char *ports;                /* MT7530 port 0..4 netdev ids, ':' separated */
+    uint32_t usb;               /* 0 = none, 2 = USB 2.0, 3 = USB 3.0 port */
+    char *usb_host;             /* passed through host devices VID:PID;... */
+    bool gpio_log;
+    uint32_t reset_hold;
+    uint32_t reset_gpio, wps_gpio;
+    bool reset_high, wps_high;
+    char *led_def[MAX_LEDS];
+    uint32_t ddr;               /* 2 or 3 */
+} MT7621Board;
+
+typedef struct MT7621MachineState {
+    MachineState parent;
+    MT7621Board b;
+} MT7621MachineState;
+
+#define TYPE_MT7621_MACHINE MACHINE_TYPE_NAME("mt7621-router")
+OBJECT_DECLARE_SIMPLE_TYPE(MT7621MachineState, MT7621_MACHINE)
+
+static MT7621Board *the_board;
+
+/*
+ * Palmbus: a plain register file that remembers writes, with the reset
+ * values the boot code needs.  Unmodelled blocks behave like this too;
+ * accesses are traced with -d unimp.
+ */
+/*
+ * Status bits the DDR init blob polls (calibration / PLL done): they
+ * read as set, the real hardware sets them within microseconds.
+ */
+static const struct {
+    hwaddr reg;
+    uint32_t set;
+} dramc_status[] = {
+    { 0x1e0053fc, 0x00000400 },
+};
+
+static uint64_t palmbus_read(void *opaque, hwaddr addr, unsigned size)
+{
+    MT7621Board *b = opaque;
+    uint32_t v = b->palm_regs[addr >> 2];
+
+    for (int i = 0; i < ARRAY_SIZE(dramc_status); i++) {
+        if (dramc_status[i].reg == MT7621_PALMBUS_BASE + (addr & ~3)) {
+            v |= dramc_status[i].set;
+        }
+    }
+    switch (MT7621_PALMBUS_BASE + (addr & ~3)) {
+    /* SSUSB IPPC: clocks stable, IP sleeps when the host is powered down */
+    case MT7621_IPPC_BASE + 0x10:
+        v = BIT(0) | BIT(8) | BIT(10) | BIT(11) | BIT(16) |
+            ((b->palm_regs[(MT7621_IPPC_BASE + 4 - MT7621_PALMBUS_BASE) / 4]
+              & 1) ? BIT(30) : 0);
+        break;
+    case MT7621_IPPC_BASE + 0x24:       /* IP_XHCI_CAP: 1 USB3 + 1 USB2 */
+        v = 0x0101;
+        break;
+    }
+
+    qemu_log_mask(LOG_UNIMP, "mt7621: read  0x%08" HWADDR_PRIx " = 0x%08x\n",
+                  MT7621_PALMBUS_BASE + addr, v);
+    return v >> ((addr & 3) * 8);
+}
+
+static void palmbus_write(void *opaque, hwaddr addr, uint64_t val,
+                          unsigned size)
+{
+    MT7621Board *b = opaque;
+    uint32_t *r = &b->palm_regs[addr >> 2];
+    unsigned sh = (addr & 3) * 8;
+    uint32_t mask = (size == 4 ? 0xffffffffu : ((1u << (size * 8)) - 1)) << sh;
+
+    qemu_log_mask(LOG_UNIMP, "mt7621: write 0x%08" HWADDR_PRIx " = 0x%08x\n",
+                  MT7621_PALMBUS_BASE + addr, (uint32_t)val);
+
+    switch (MT7621_PALMBUS_BASE + (addr & ~3)) {
+    case MT7621_SYSCTL_BASE + SYSC_CHIP_NAME0:
+    case MT7621_SYSCTL_BASE + SYSC_CHIP_NAME1:
+    case MT7621_SYSCTL_BASE + SYSC_CHIP_REV:
+    case MT7621_SYSCTL_BASE + SYSC_SYSCFG0:
+    case MT7621_SYSCTL_BASE + SYSC_CUR_CLK_STS:
+        return;                         /* read-only */
+    case MT7621_SYSCTL_BASE + SYSC_RSTCTL:
+        if (val & 1) {                  /* SYS_RST */
+            qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+        }
+        val &= ~1ull;
+        break;
+    }
+    *r = (*r & ~mask) | (((uint32_t)val << sh) & mask);
+}
+
+static const MemoryRegionOps palmbus_ops = {
+    .read = palmbus_read,
+    .write = palmbus_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void palmbus_reset(MT7621Board *b)
+{
+    uint32_t *sc = &b->palm_regs[(MT7621_SYSCTL_BASE - MT7621_PALMBUS_BASE) / 4];
+
+    memset(b->palm_regs, 0, sizeof(b->palm_regs));
+    sc[SYSC_CHIP_NAME0 / 4] = 0x3637544d;       /* "MT76" */
+    sc[SYSC_CHIP_NAME1 / 4] = 0x20203132;       /* "21  " */
+    /*
+     * ver 1, eco 3; MT7621A (dual core, PKG_ID A) or, with one emulated
+     * CPU, MT7621S (single core)
+     */
+    sc[SYSC_CHIP_REV / 4] = (b->machine->smp.cpus > 1 ? 0x00030103
+                                                      : 0x00010103);
+    /*
+     * Bootstrap: XTAL 40 MHz (XTAL_MODE_SEL 3), DRAM type (bit 4: DDR2),
+     * chip mode 2 = SPI-NOR 3-byte address
+     */
+    sc[SYSC_SYSCFG0 / 4] = (3 << 6) | (b->ddr == 2 ? 0x10 : 0) | 2;
+    sc[SYSC_CUR_CLK_STS / 4] = 0x0101;           /* CPU FDIV 1, FFRAC 1 */
+}
+
+/*
+ * CACHE instructions.  The TPL locks lines of the L2 cache and fills
+ * them (Index Store Tag / Index Store Data, secondary cache) to run the
+ * SPL from the cache before the DRAM works.  There is no cache here and
+ * the DRAM always works, so the data goes straight to the memory behind
+ * the line.
+ */
+static void mt7621_cache_hook(CPUMIPSState *env, target_ulong addr,
+                              uint32_t op)
+{
+    if (op == 0x0f) {   /* Index Store Data, secondary cache */
+        uint32_t d[2] = { cpu_to_le32(env->CP0_DataLo),
+                          cpu_to_le32(env->CP0_DataHi) };
+
+        address_space_write(&address_space_memory, addr & 0x1ffffff8,
+                            MEMTXATTRS_UNSPECIFIED, d, sizeof(d));
+    }
+}
+
+static void mt7621_reset(void *opaque)
+{
+    palmbus_reset(opaque);
+}
+
+/* SPI-NOR boot flash on SPI CS0: a folder of partition dumps or a drive */
+static void mt7621_create_flash(MT7621Board *b)
+{
+    DriveInfo *dinfo = drive_get(IF_MTD, 0, 0);
+    DeviceState *dev;
+    uint64_t size;
+    uint8_t *data;
+
+    b->spi = qdev_new(TYPE_MT7621_SPI);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(b->spi), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(b->spi), 0, MT7621_SPI_BASE);
+
+    dev = qdev_new(TYPE_MTK_SPINOR);
+    qdev_prop_set_uint32(dev, "size-mb", 16);
+    if (b->flash_dir) {
+        qdev_prop_set_string(dev, "dir", b->flash_dir);
+    } else if (dinfo) {
+        qdev_prop_set_drive_err(dev, "drive", blk_by_legacy_dinfo(dinfo),
+                                &error_fatal);
+    } else {
+        warn_report("no flash given (-M mt7621-router,nand-dir=DIR or "
+                    "-drive if=mtd,format=raw,file=NOR_IMAGE), "
+                    "using an erased flash");
+    }
+    qdev_realize_and_unref(dev, BUS(qdev_get_child_bus(b->spi, "spi")),
+                           &error_fatal);
+    sysbus_connect_irq(SYS_BUS_DEVICE(b->spi), 0,
+                       qdev_get_gpio_in_named(dev, SSI_GPIO_CS, 0));
+    b->nor = MTK_SPINOR(dev);
+
+    /* memory-mapped read window at the reset vector */
+    data = spinor_storage(b->nor, &size);
+    memory_region_init_ram_ptr(&b->flash_mmap, NULL, "mt7621.flash-mmap",
+                               MIN(size, MT7621_FLASH_MMAP_SIZE), data);
+    memory_region_set_readonly(&b->flash_mmap, true);
+    memory_region_add_subregion(get_system_memory(), MT7621_FLASH_MMAP_BASE,
+                                &b->flash_mmap);
+}
+
+/* Frame engine (QDMA TX, PDMA RX), GMAC, MT7530 switch (MCM) on MDIO 31 */
+static void mt7621_create_eth(MT7621Board *b)
+{
+    DeviceState *dev = qdev_new(TYPE_MTK_ETH);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+    g_auto(GStrv) ports = g_strsplit(b->ports ? b->ports : "", ":", 0);
+
+    qdev_prop_set_uint32(dev, "pdma-base", 0x0800);
+    qdev_prop_set_uint32(dev, "qdma-base", 0x1800);
+    qdev_prop_set_uint32(dev, "pdma2-base", 0xfff000);     /* none */
+    qdev_prop_set_bit(dev, "single-irq", true);
+    qdev_prop_set_uint32(dev, "switch-model", 3);
+    for (int i = 0; i < 5 && ports[i]; i++) {
+        g_autofree char *prop = g_strdup_printf("netdev-p%d", i);
+        NetClientState *nc = *ports[i] && strcmp(ports[i], "-")
+                             ? qemu_find_netdev(ports[i]) : NULL;
+        if (nc) {
+            qdev_prop_set_netdev(dev, prop, nc);
+        }
+    }
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    /* above the palmbus register file, below the PSE SRAM */
+    memory_region_add_subregion_overlap(get_system_memory(), MT7621_FE_BASE,
+                                        sysbus_mmio_get_region(sbd, 0), -5);
+    sysbus_connect_irq(sbd, 0, get_cps_irq(&b->cps, MT7621_IRQ_FE));
+    qdev_connect_gpio_out_named(dev, "switch-irq", 0,
+                                get_cps_irq(&b->cps, MT7621_IRQ_SWITCH));
+    b->eth = dev;
+}
+
+/*
+ * xHCI (with the MediaTek IPPC wrapper in the palmbus register file):
+ * one USB 3.0 and one USB 2.0 root port, the board's connector on one of
+ * them; usb-host=VID:PID[;...] devices of the host on USB 2.0 ports 2, 3...
+ */
+static void mt7621_create_usb(MT7621Board *b)
+{
+    DeviceState *dev = qdev_new(TYPE_XHCI_SYSBUS);
+    g_auto(GStrv) hosts = g_strsplit_set(b->usb_host ? b->usb_host : "",
+                                         "; ", -1);
+    int nhost = 0;
+
+    for (int i = 0; hosts[i]; i++) {
+        nhost += *hosts[i] != 0;
+    }
+    qdev_prop_set_uint32(dev, "slots", 32);
+    qdev_prop_set_uint32(DEVICE(&XHCI_SYSBUS(dev)->xhci), "p2",
+                         nhost ? 1 + nhost : b->usb ? 1 : 0);
+    qdev_prop_set_uint32(DEVICE(&XHCI_SYSBUS(dev)->xhci), "p3",
+                         b->usb == 3 ? 1 : 0);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, MT7621_XHCI_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                       get_cps_irq(&b->cps, MT7621_IRQ_XHCI));
+    if (nhost && !object_class_by_name("usb-host")) {
+        error_report("usb-host: this QEMU is built without USB "
+                     "pass-through (libusb)");
+        exit(1);
+    }
+    for (int i = 0, n = 0; hosts[i]; i++) {
+        unsigned vid, pid;
+        DeviceState *host;
+        g_autofree char *port = NULL;
+
+        if (!*hosts[i]) {
+            continue;
+        }
+        if (sscanf(hosts[i], "%x:%x", &vid, &pid) != 2 ||
+            vid > 0xffff || pid > 0xffff) {
+            error_report("usb-host: \"%s\": expected VID:PID (hex), e.g. "
+                         "148f:5370", hosts[i]);
+            exit(1);
+        }
+        port = g_strdup_printf("%d", 2 + n++);
+        host = qdev_new("usb-host");
+        qdev_prop_set_uint32(host, "vendorid", vid);
+        qdev_prop_set_uint32(host, "productid", pid);
+        qdev_prop_set_string(host, "port", port);
+        qdev_realize_and_unref(host, BUS(&XHCI_SYSBUS(dev)->xhci.bus),
+                               &error_fatal);
+    }
+}
+
+/* LED panel: PWM LED sources (Filogic sysctl registers) do not exist here */
+uint32_t mtk_sysctl_peek(DeviceState *dev, hwaddr a)
+{
+    return 0;
+}
+
+/* GPIO (3 x 32 pins), buttons, front panel LEDs */
+static void mt7621_create_gpio(MT7621Board *b)
+{
+    DeviceState *dev = qdev_new(TYPE_MTK_PINCTRL);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+    RouterLedsHw hw = { 0 };
+
+    qdev_prop_set_bit(dev, "mt7621", true);
+    qdev_prop_set_uint32(dev, "npins", 96);
+    qdev_prop_set_uint32(dev, "reset-pin", b->reset_gpio);
+    qdev_prop_set_uint32(dev, "wps-pin", b->wps_gpio);
+    qdev_prop_set_bit(dev, "reset-active-high", b->reset_high);
+    qdev_prop_set_bit(dev, "wps-active-high", b->wps_high);
+    qdev_prop_set_bit(dev, "gpio-log", b->gpio_log);
+    qdev_prop_set_uint32(dev, "reset-hold", b->reset_hold);
+    /* same QOM path as on Filogic: the launcher presses buttons there */
+    object_property_add_child(OBJECT(b->machine), "pinctrl", OBJECT(dev));
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    /* the block is 0x100 bytes: map only that much of the model */
+    memory_region_init_alias(&b->gpio_alias, NULL, "mt7621.gpio",
+                             sysbus_mmio_get_region(sbd, 0), 0, 0x100);
+    memory_region_add_subregion(get_system_memory(), MT7621_GPIO_BASE,
+                                &b->gpio_alias);
+    sysbus_connect_irq(sbd, 0, get_cps_irq(&b->cps, MT7621_IRQ_GPIO));
+    b->pinctrl = dev;
+
+    hw.pinctrl = dev;
+    hw.eth = b->eth;
+    b->leds = router_leds_new(b->led_def, MAX_LEDS, &hw, b->gpio_log,
+                              &error_fatal);
+}
+
+static void mt7621_init(MachineState *machine)
+{
+    MT7621MachineState *ms = MT7621_MACHINE(machine);
+    MT7621Board *b = &ms->b;
+    MemoryRegion *sysmem = get_system_memory();
+    uint64_t ram_size = machine->ram_size;
+    uint64_t low = MIN(ram_size, MT7621_LOWMEM_MAX);
+    CPUState *cs;
+
+    the_board = b;
+    b->machine = machine;
+
+    if (ram_size != 128 * MiB && ram_size != 256 * MiB &&
+        ram_size != 512 * MiB) {
+        error_report("RAM size must be 128M, 256M or 512M");
+        exit(1);
+    }
+
+    /* CPU cores, CM GCR, CPC, GIC */
+    b->cpuclk = clock_new(OBJECT(machine), "cpu-refclk");
+    clock_set_hz(b->cpuclk, MT7621_CPU_HZ);
+    object_initialize_child(OBJECT(machine), "cps", &b->cps, TYPE_MIPS_CPS);
+    object_property_set_str(OBJECT(&b->cps), "cpu-type", machine->cpu_type,
+                            &error_fatal);
+    object_property_set_uint(OBJECT(&b->cps), "num-vp", machine->smp.cpus,
+                             &error_fatal);
+    object_property_set_int(OBJECT(&b->cps), "gcr-rev", 0x600, &error_fatal);
+    qdev_connect_clock_in(DEVICE(&b->cps), "clk-in", b->cpuclk);
+    sysbus_realize(SYS_BUS_DEVICE(&b->cps), &error_fatal);
+    sysbus_mmio_map_overlap(SYS_BUS_DEVICE(&b->cps), 0, 0, 1);
+    /* the GIC counter runs at the CPU clock (Linux: clocks = CPU) */
+    mips_gictimer_set_freq(b->cps.gic.gic_timer, MT7621_CPU_HZ);
+
+    CPU_FOREACH(cs) {
+        cpu_env(cs)->cache_hook = mt7621_cache_hook;
+    }
+
+    /* DRAM, with address wrap-around below 448 MB */
+    memory_region_init_alias(&b->lowmem, NULL, "mt7621.lowmem", machine->ram,
+                             0, low);
+    memory_region_add_subregion(sysmem, 0, &b->lowmem);
+    for (uint64_t a = low, i = 0;
+         a < MT7621_LOWMEM_MAX && i < ARRAY_SIZE(b->dram_alias);
+         a += low, i++) {
+        memory_region_init_alias(&b->dram_alias[i], NULL, "mt7621.dram-alias",
+                                 machine->ram, 0,
+                                 MIN(low, MT7621_LOWMEM_MAX - a));
+        memory_region_add_subregion(sysmem, a, &b->dram_alias[i]);
+    }
+    if (ram_size > MT7621_LOWMEM_MAX) {
+        memory_region_init_alias(&b->highmem, NULL, "mt7621.highmem",
+                                 machine->ram, MT7621_LOWMEM_MAX,
+                                 ram_size - MT7621_LOWMEM_MAX);
+        memory_region_add_subregion(sysmem, MT7621_HIGHMEM_BASE, &b->highmem);
+    }
+
+    /* Palmbus register file (lowest priority) */
+    memory_region_init_io(&b->palmbus, NULL, &palmbus_ops, b,
+                          "mt7621.palmbus", MT7621_PALMBUS_SIZE);
+    memory_region_add_subregion_overlap(sysmem, MT7621_PALMBUS_BASE,
+                                        &b->palmbus, -10);
+    palmbus_reset(b);
+    qemu_register_reset(mt7621_reset, b);
+
+    /* Frame Engine PSE SRAM: early stack, DDR init blob */
+    memory_region_init_ram(&b->fe_sram, NULL, "mt7621.fe-sram",
+                           MT7621_FE_SRAM_SIZE, &error_fatal);
+    memory_region_add_subregion_overlap(sysmem, MT7621_FE_SRAM_BASE,
+                                        &b->fe_sram, 1);
+
+    mt7621_create_flash(b);
+    mt7621_create_eth(b);
+    mt7621_create_usb(b);
+    mt7621_create_gpio(b);
+
+    /* UART1 (console) */
+    serial_mm_init(sysmem, MT7621_UART0_BASE, 2,
+                   get_cps_irq(&b->cps, MT7621_IRQ_UART0), 50000000 / 16,
+                   serial_hd(0), DEVICE_LITTLE_ENDIAN);
+}
+
