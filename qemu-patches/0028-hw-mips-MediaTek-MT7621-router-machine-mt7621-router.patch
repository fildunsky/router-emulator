+    }
     if (addr == 0) {
         return &s->intphy;
     }
@@ -1695,6 +1702,10 @@ static void fe_update_irq(MtkEthState *s)
                (s->pdma[1].regs[PDMA_IRQ_STATUS / 4] &
                 s->pdma[1].regs[PDMA_GRP_MSK(n) / 4]);
     }
+    if (s->single_irq) {
+        qemu_set_irq(s->irq[0], q || p || p2);
+        return;
+    }
     qemu_set_irq(s->irq[0], g[0]);
     qemu_set_irq(s->irq[1], q || (p & 0x1000000f) || (p2 & 0x1000000f) || g[1]);
     qemu_set_irq(s->irq[2], (p & 0x400f4000) || (p2 & 0x400f4000) || g[2]);
@@ -1836,12 +1847,27 @@ static void qdma_kick(MtkEthState *s)
         if (d[2] & TXD3_OWNER_CPU) {
             break;      /* not handed to DMA */
         }
-        plen = (d[2] >> 8) & 0xffff;
-        if (flen == 0) {
-            fport = (d[3] >> 8) & 0xf;
-            tso = d[4] & BIT(31);
-            csum = (d[4] >> 28) & 0x7;
-            vlan = d[5];
+        if (s->qdma_base != 0x4400) {
+            /*
+             * NETSYS v1 (MT7621): 16-byte descriptors, PLEN0 in txd3
+             * bits 29:16, txd4: forward port 27:25, TSO 28, checksum
+             * 31:29, VLAN insert 16 + TCI
+             */
+            plen = (d[2] >> 16) & 0x3fff;
+            if (flen == 0) {
+                fport = (d[3] >> 25) & 0x7;
+                tso = d[3] & BIT(28);
+                csum = (d[3] >> 29) & 0x7;
+                vlan = d[3] & 0x1ffff;
+            }
+        } else {
+            plen = (d[2] >> 8) & 0xffff;
+            if (flen == 0) {
+                fport = (d[3] >> 8) & 0xf;
+                tso = d[4] & BIT(31);
+                csum = (d[4] >> 28) & 0x7;
+                vlan = d[5];
+            }
         }
         if (flen + plen <= MAX_FRAME - 8) {
             dma_memory_read(&address_space_memory, d[0], s->txbuf + flen,
@@ -1984,8 +2010,13 @@ static uint64_t fe_read(void *opaque, hwaddr addr, unsigned size)
     MtkEthState *s = opaque;
     uint32_t v;
 
-    if (addr >= PDMA_BASE && addr < PDMA_BASE + 0x300) {
-        return pdma_read(&s->pdma[0], addr - PDMA_BASE);
+    if (addr >= s->pdma_base && addr < s->pdma_base + 0x300) {
+        return pdma_read(&s->pdma[0], addr - s->pdma_base);
+    }
+    if (addr >= s->qdma_base && addr < s->qdma_base + 0x400) {
+        addr = addr - s->qdma_base + 0x4400;    /* the NETSYS layout */
+    } else if (addr >= 0x4000 && addr < 0x4800 && s->qdma_base != 0x4400) {
+        return ht_get(s->fe, addr, 0);
     }
     if (addr >= s->pdma2_base && addr < s->pdma2_base + 0x300) {
