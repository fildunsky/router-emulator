+static void mt7621_set_flash_dir(Object *obj, const char *v, Error **errp)
+{
+    MT7621MachineState *ms = MT7621_MACHINE(obj);
+
+    g_free(ms->b.flash_dir);
+    ms->b.flash_dir = g_strdup(v);
+}
+
+static char *mt7621_get_ddr(Object *obj, Error **errp)
+{
+    return g_strdup(MT7621_MACHINE(obj)->b.ddr == 2 ? "ddr2" : "ddr3");
+}
+
+static void mt7621_set_ddr(Object *obj, const char *v, Error **errp)
+{
+    MT7621MachineState *ms = MT7621_MACHINE(obj);
+
+    if (!strcmp(v, "ddr2")) {
+        ms->b.ddr = 2;
+    } else if (!strcmp(v, "ddr3")) {
+        ms->b.ddr = 3;
+    } else {
+        error_setg(errp, "ddr must be ddr2 or ddr3");
+    }
+}
