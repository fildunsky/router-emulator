@@ -2018,8 +2049,14 @@ static void fe_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
     MtkEthState *s = opaque;
     uint32_t v = val;
 
-    if (addr >= PDMA_BASE && addr < PDMA_BASE + 0x300) {
-        pdma_write(s, &s->pdma[0], addr - PDMA_BASE, v);
+    if (addr >= s->pdma_base && addr < s->pdma_base + 0x300) {
