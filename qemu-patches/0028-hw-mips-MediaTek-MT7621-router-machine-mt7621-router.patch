+static void mt7621_get_led(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    char *d = MT7621_MACHINE(obj)->b.led_def[(uintptr_t)opaque];
+    char *value = g_strdup(d ? d : "");
+
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
