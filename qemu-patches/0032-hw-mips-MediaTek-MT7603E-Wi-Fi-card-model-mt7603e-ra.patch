 mips_ss.add(when: 'CONFIG_MT7621_ROUTER', if_true: files('mt7621.c', 'mt7621_nand.c', 'mt7621_pcie.c',
-  'mt76x2_wifi.c',
+  'mt76x2_wifi.c', 'mt7603_wifi.c',
   '../arm/filogic/spinor.c', '../arm/filogic/mtk_eth.c',
   '../arm/filogic/mtk_pinctrl.c', '../arm/filogic/filogic_leds.c',
   '../arm/filogic/ws2812b.c', '../arm/filogic/hc595.c'))
diff --git a/hw/mips/mt7603_wifi.c b/hw/mips/mt7603_wifi.c
new file mode 100644
index 0000000..aedb271
--- /dev/null
+++ b/hw/mips/mt7603_wifi.c
@@ -0,0 +1,324 @@
+/*
+ * MediaTek MT7603E (802.11n 2x2, 2.4 GHz) PCIe card - "radio silent" model.
+ *
+ * Enough of the chip for the unmodified mt7603e driver: chip ID and
+ * revision, the two PCIe remap windows into the chip address space (a
+ * sparse register file), eFuse (a minimal EEPROM: chip ID, MAC, 2x2) for
+ * boards without one in flash, ROM / firmware ready flags, and the WPDMA
+ * rings: every MCU command gets an event with its sequence number on RX
+ * ring 1, firmware start sets "running", TX frames are completed.  Nothing
+ * goes on the air.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/pci/pci_device.h"
+#include "hw/pci/pcie.h"
+#include "hw/qdev-properties.h"
+#include "system/dma.h"
+#include "net/net.h"
+
+#define TYPE_MT7603_WIFI "mt7603e"
+OBJECT_DECLARE_SIMPLE_TYPE(Mt7603State, MT7603_WIFI)
+
+#define BAR0_SIZE       0x100000
+#define R_HW_REV        0x1000
+#define R_HW_CHIPID     0x1008
+#define R_TOP_MISC2     0x1134
+#define R_REMAP_1       0x2500          /* chip address bits 31:18 */
+#define R_REMAP_2       0x2504          /* chip address bits 31:19 */
+#define WIN_1           0x40000
+#define WIN_2           0x80000
+#define R_INT_SOURCE    0x4200
+#define R_INT_MASK      0x4204
+#define R_WPDMA_GLO     0x4208
+#define R_WPDMA_RST     0x420c
+#define R_TX_RING       0x4300
+#define R_RX_RING       0x4400
+#define R_PSE_RTA       0x8194
+
+#define EFUSE_BASE      0x81070000u     /* chip address */
+#define EFUSE_CTRL      0x008
+#define  EFUSE_KICK     BIT(30)
+#define  EFUSE_VALID    BIT(29)
+#define EFUSE_RDATA     0x030
+
+#define NTXQ            16
+#define NRXQ            2
+#define MCU_TXQ         5
+#define MCU_RXQ         1
+#define EEPROM_SIZE     1024
+
+#define CMD_FW_START    0x02
+
+#define DMA_DONE        BIT(31)
+#define LAST_SEC0       BIT(30)
+
+struct Mt7603State {
+    PCIDevice parent_obj;
+
+    MemoryRegion bar0;
+    uint32_t r[WIN_1 / 4];              /* direct registers */
+    GHashTable *chip;                   /* chip address -> value */
+    uint8_t eeprom[EEPROM_SIZE];
+    MACAddr mac;
+};
+
+static void update_irq(Mt7603State *s)
+{
+    pci_set_irq(PCI_DEVICE(s),
+                !!(s->r[R_INT_SOURCE / 4] & s->r[R_INT_MASK / 4]));
+}
+
+static void raise_irq(Mt7603State *s, uint32_t bits)
+{
+    s->r[R_INT_SOURCE / 4] |= bits;
+    update_irq(s);
+}
+
+static void eeprom_init(Mt7603State *s)
+{
+    memset(s->eeprom, 0xff, sizeof(s->eeprom));
+    stw_le_p(s->eeprom + 0x00, 0x7603);
+    stw_le_p(s->eeprom + 0x02, 0x0001);
+    memcpy(s->eeprom + 0x04, s->mac.a, 6);
+    s->eeprom[0x34] = 0x22;             /* NIC_CONF_0: 2 RX, 2 TX paths */
+    s->eeprom[0x35] = 0x00;
+}
+
+/* BAR0 offset in a remap window -> chip address */
+static uint32_t chip_addr(Mt7603State *s, hwaddr off)
+{
+    if (off >= WIN_2) {
+        return (s->r[R_REMAP_2 / 4] & 0xfff80000) + (off - WIN_2);
+    }
+    return (s->r[R_REMAP_1 / 4] & 0xfffc0000) + (off - WIN_1);
+}
+
+static uint32_t chip_get(Mt7603State *s, uint32_t a)
+{
+    return GPOINTER_TO_UINT(g_hash_table_lookup(s->chip,
+                                                GUINT_TO_POINTER(a)));
+}
+
+static void chip_set(Mt7603State *s, uint32_t a, uint32_t v)
+{
+    g_hash_table_insert(s->chip, GUINT_TO_POINTER(a), GUINT_TO_POINTER(v));
+}
+
+static void efuse_kick(Mt7603State *s, uint32_t ctrl)
+{
+    uint32_t a = ((ctrl >> 16) & 0x3ff) & ~0xf;
+
+    for (int i = 0; i < 4; i++) {
+        chip_set(s, EFUSE_BASE + EFUSE_RDATA + 4 * i,
+                 a + 16 <= EEPROM_SIZE ? ldl_le_p(s->eeprom + a + 4 * i)
+                                       : 0xffffffff);
+    }
+    chip_set(s, EFUSE_BASE + EFUSE_CTRL,
+             (ctrl & ~(EFUSE_KICK | 0x3f)) | EFUSE_VALID);
+}
+
+static uint32_t *ring(Mt7603State *s, hwaddr base, int q)
+{
+    return &s->r[(base + q * 0x10) / 4];
+}
+
+/* event for MCU command cid / seq: RX descriptor type 7 (RX_EVENT) */
+static void mcu_event(Mt7603State *s, uint8_t cid, uint8_t seq)
+{
+    uint32_t *rq = ring(s, R_RX_RING, MCU_RXQ);
+    uint32_t size = rq[1], didx = rq[3], desc[4];
+    uint8_t ev[12] = { 0 };
+    dma_addr_t d;
+
+    if (!rq[0] || !size || didx == rq[2] % size) {
+        return;
+    }
+    stw_le_p(ev + 0, sizeof(ev));
+    stw_le_p(ev + 2, 7 << 13);          /* PKT_TYPE_RX_EVENT */
+    ev[4] = cid;
+    ev[5] = seq;
+    d = rq[0] + didx * 16;
+    pci_dma_read(PCI_DEVICE(s), d, desc, sizeof(desc));
+    pci_dma_write(PCI_DEVICE(s), le32_to_cpu(desc[0]), ev, sizeof(ev));
+    desc[1] = cpu_to_le32(DMA_DONE | LAST_SEC0 | (sizeof(ev) << 16));
+    desc[3] = 0;
+    pci_dma_write(PCI_DEVICE(s), d, desc, sizeof(desc));
+    rq[3] = (didx + 1) % size;
+    raise_irq(s, BIT(MCU_RXQ));
+}
+
+static void tx_kick(Mt7603State *s, int q)
+{
+    uint32_t *tq = ring(s, R_TX_RING, q);
+    uint32_t size = tq[1];
+
+    if (!tq[0] || !size) {
+        return;
+    }
+    while (tq[3] != tq[2] % size) {
+        dma_addr_t d = tq[0] + tq[3] * 16;
+        uint32_t desc[4];
+
+        pci_dma_read(PCI_DEVICE(s), d, desc, sizeof(desc));
+        desc[1] |= cpu_to_le32(DMA_DONE);
+        pci_dma_write(PCI_DEVICE(s), d + 4, &desc[1], 4);
+        if (q == MCU_TXQ) {
+            uint8_t txd[8];
+
+            /* MCU TXD: cid at 4, sequence number at 7 */
+            pci_dma_read(PCI_DEVICE(s), le32_to_cpu(desc[0]), txd,
+                         sizeof(txd));
+            if (txd[4] == CMD_FW_START) {
+                s->r[R_TOP_MISC2 / 4] |= BIT(1);    /* firmware running */
+            }
+            mcu_event(s, txd[4], txd[7]);
+        }
+        tq[3] = (tq[3] + 1) % size;
+    }
+    raise_irq(s, BIT(q + 4));
+}
+
+static uint64_t bar0_read(void *opaque, hwaddr off, unsigned size)
+{
+    Mt7603State *s = opaque;
+
+    if (off >= WIN_1) {
+        uint32_t a = chip_addr(s, off);
+
+        if (a == EFUSE_BASE) {
+            return 0;                   /* BASE_CTRL: eFuse not empty */
+        }
+        return chip_get(s, a);
+    }
+    switch (off) {
+    case R_HW_CHIPID:
+        return 0x7603;
+    case R_HW_REV:
+        return 0x10;                    /* E2 */
+    case R_WPDMA_GLO:
+        return s->r[off / 4] & ~(BIT(1) | BIT(3));      /* never busy */
+    case R_PSE_RTA:
+        return s->r[off / 4] & ~BIT(31);
+    }
+    return s->r[off / 4];
+}
+
+static void bar0_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    Mt7603State *s = opaque;
+    uint32_t v = val;
+
+    if (off >= WIN_1) {
+        uint32_t a = chip_addr(s, off);
+
+        if (a == EFUSE_BASE + EFUSE_CTRL && (v & EFUSE_KICK)) {
+            efuse_kick(s, v);
+            return;
+        }
+        chip_set(s, a, v);
+        return;
+    }
+    switch (off) {
+    case R_INT_SOURCE:
+        s->r[off / 4] &= ~v;
+        update_irq(s);
+        return;
+    case R_INT_MASK:
+        s->r[off / 4] = v;
+        update_irq(s);
+        return;
+    case R_WPDMA_RST:
+        for (int q = 0; q < NTXQ; q++) {
+            if (v & BIT(q)) {
+                ring(s, R_TX_RING, q)[3] = 0;
+            }
+        }
+        for (int q = 0; q < NRXQ; q++) {
+            if (v & BIT(16 + q)) {
+                ring(s, R_RX_RING, q)[3] = 0;
+            }
+        }
+        return;
+    }
+    s->r[off / 4] = v;
+    if (off >= R_TX_RING && off < R_TX_RING + NTXQ * 0x10 &&
+        (off & 0xf) == 8) {
+        tx_kick(s, (off - R_TX_RING) / 0x10);
+    }
+}
+
+static const MemoryRegionOps bar0_ops = {
+    .read = bar0_read,
+    .write = bar0_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void mt7603_reset(DeviceState *dev)
+{
+    Mt7603State *s = MT7603_WIFI(dev);
+
+    memset(s->r, 0, sizeof(s->r));
+    g_hash_table_remove_all(s->chip);
+    s->r[R_TOP_MISC2 / 4] = BIT(0);     /* ROM code ready */
+    update_irq(s);
+}
+
+static void mt7603_realize(PCIDevice *pd, Error **errp)
+{
+    Mt7603State *s = MT7603_WIFI(pd);
+
+    pd->config[PCI_INTERRUPT_PIN] = 1;
+    if (pcie_endpoint_cap_init(pd, 0x80) < 0) {
+        error_setg(errp, "mt7603e: PCIe capability");
+        return;
+    }
+    s->chip = g_hash_table_new(g_direct_hash, g_direct_equal);
+    memory_region_init_io(&s->bar0, OBJECT(s), &bar0_ops, s, "mt7603e",
+                          BAR0_SIZE);
+    pci_register_bar(pd, 0, PCI_BASE_ADDRESS_SPACE_MEMORY, &s->bar0);
+    eeprom_init(s);
+}
+
+static const Property mt7603_props[] = {
+    DEFINE_PROP_MACADDR("mac", Mt7603State, mac),
+};
+
+static void mt7603_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    k->realize = mt7603_realize;
+    k->vendor_id = 0x14c3;
+    k->device_id = 0x7603;
+    k->class_id = PCI_CLASS_NETWORK_OTHER;
+    device_class_set_legacy_reset(dc, mt7603_reset);
+    device_class_set_props(dc, mt7603_props);
+    dc->desc = "MediaTek MT7603E Wi-Fi (radio silent)";
+    set_bit(DEVICE_CATEGORY_NETWORK, dc->categories);
+}
+
+static const TypeInfo mt7603_info = {
+    .name = TYPE_MT7603_WIFI,
+    .parent = TYPE_PCI_DEVICE,
+    .instance_size = sizeof(Mt7603State),
+    .class_init = mt7603_class_init,
+    .interfaces = (const InterfaceInfo[]) {
+        { INTERFACE_PCIE_DEVICE },
+        { }
+    },
+};
+
+static void mt7603_register_types(void)
+{
+    type_register_static(&mt7603_info);
+}
+
+type_init(mt7603_register_types)
-- 
