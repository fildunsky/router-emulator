From f48b11f6934a4762662762aebc81a959800bf6d2 Mon Sep 17 00:00:00 2001
From: Dmitry Mostovoy <stavultras@gmail.com>
Date: Mon, 19 Oct 2026 07:49:28 -0400
Subject: [PATCH] hw/arm/filogic: allow 128 MB of RAM

Untested beyond the BL2's size detection ("Detected DRAM size: 128MB"):
there is no BL2 built for a 128 MB board to try.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012GbUcwR34gg9RgGTEtNN6J
---
 hw/arm/filogic/filogic_router.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/hw/arm/filogic/filogic_router.c b/hw/arm/filogic/filogic_router.c
index 0b98b2e..47140ec 100644
--- a/hw/arm/filogic/filogic_router.c
+++ b/hw/arm/filogic/filogic_router.c
@@ -910,9 +910,9 @@ static void router_init(MachineState *machine)
 
     the_board = b;
 
-    if (ram_size != 256 * MiB && ram_size != 512 * MiB && ram_size != 1 * GiB &&
-        ram_size != 2 * GiB) {
-        error_report("RAM size must be 256M, 512M, 1G or 2G");
+    if (!is_power_of_2(ram_size) || ram_size < 128 * MiB ||
+        ram_size > 2 * GiB) {
+        error_report("RAM size must be 128M, 256M, 512M, 1G or 2G");
         exit(1);
     }
     if (b->nand_mb != 128 && b->nand_mb != 256 && b->nand_mb != 512) {
-- 
2.47.3

