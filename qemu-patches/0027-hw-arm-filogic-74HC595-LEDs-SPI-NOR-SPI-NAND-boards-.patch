diff --git a/hw/arm/filogic/hc595.c b/hw/arm/filogic/hc595.c
new file mode 100644
index 0000000..7b57546
--- /dev/null
+++ b/hw/arm/filogic/hc595.c
@@ -0,0 +1,124 @@
+/*
+ * 74HC595 shift registers (a chain of up to 4) on a SPI bus, as driven by
+ * Linux's gpio-74x164 (e.g. the Teltonika RUTC50 mobile / SIM / signal
+ * LEDs): every update is one SPI message of one byte per register, the
+ * last register's byte first; deasserting CS (RCLK) latches the outputs.
+ * Output pin N is bit N % 8 of the byte for register N / 8, i.e. byte
+ * (bytes in the frame - 1 - N / 8) of the frame.  Only the latched outputs
+ * are kept, for the LED panel.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "hw/ssi/ssi.h"
+#include "filogic.h"
+
+#define HC_MAX_REGS     4
+
+OBJECT_DECLARE_SIMPLE_TYPE(Hc595State, HC595_SPI)
+
+struct Hc595State {
+    SSIPeripheral parent_obj;
+    uint8_t shift[HC_MAX_REGS];     /* bytes of the frame being sent */
+    int nshift;
+    uint8_t out[HC_MAX_REGS];       /* latched outputs, in frame order */
+    int nout;
+    uint32_t changes[HC_MAX_REGS * 8];  /* on <-> off (LED panel: blinking) */
+};
+
+/* output pin N: level (-1: never latched) and the count of level changes */
+int hc595_get(DeviceState *dev, int pin, uint32_t *changes)
+{
+    Hc595State *s = HC595_SPI(dev);
+    int byte = s->nout - 1 - pin / 8;
+
+    if (pin < 0 || pin >= HC_MAX_REGS * 8) {
+        return -1;
+    }
+    *changes = s->changes[pin];
+    if (byte < 0) {
+        return -1;
+    }
+    return (s->out[byte] >> (pin % 8)) & 1;
+}
+
+static uint32_t hc595_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Hc595State *s = HC595_SPI(dev);
+
+    /* a longer frame: the first bytes have left the chain */
+    if (s->nshift == HC_MAX_REGS) {
+        memmove(s->shift, s->shift + 1, HC_MAX_REGS - 1);
+        s->nshift--;
+    }
+    s->shift[s->nshift++] = val;
+    return 0;
+}
+
+static void hc595_latch(Hc595State *s)
+{
+    for (int pin = 0; pin < s->nshift * 8; pin++) {
+        int ob = s->nout - 1 - pin / 8, nb = s->nshift - 1 - pin / 8;
+        int was = ob >= 0 ? (s->out[ob] >> (pin % 8)) & 1 : 0;
+
+        if (((s->shift[nb] >> (pin % 8)) & 1) != was) {
+            s->changes[pin]++;
+        }
+    }
+    memcpy(s->out, s->shift, s->nshift);
+    s->nout = s->nshift;
+}
+
+/* level: the CS line (active low) */
+static int hc595_set_cs(SSIPeripheral *dev, bool level)
+{
+    Hc595State *s = HC595_SPI(dev);
+
+    if (level && s->nshift) {
+        hc595_latch(s);         /* RCLK rising edge */
+    }
+    s->nshift = 0;
+    return 0;
+}
+
+static void hc595_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static void hc595_reset(DeviceState *dev)
+{
+    Hc595State *s = HC595_SPI(dev);
+
+    s->nshift = s->nout = 0;
+    memset(s->out, 0, sizeof(s->out));
+    memset(s->changes, 0, sizeof(s->changes));
+}
+
+static void hc595_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = hc595_realize;
+    k->transfer = hc595_transfer;
+    k->set_cs = hc595_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(dc, hc595_reset);
+    dc->desc = "74HC595 shift register chain (SPI)";
+}
+
+static const TypeInfo hc595_info = {
+    .name = TYPE_HC595_SPI,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(Hc595State),
+    .class_init = hc595_class_init,
+};
+
+static void hc595_register_types(void)
+{
+    type_register_static(&hc595_info);
+}
+
+type_init(hc595_register_types)
