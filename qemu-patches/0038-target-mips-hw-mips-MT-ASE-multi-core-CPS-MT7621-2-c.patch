 {
     MIPSGCRState *gcr = (MIPSGCRState *) opaque;
-    MIPSGCRVPState *current_vps = &gcr->vps[current_cpu->cpu_index];
+    int cur = gcr_current(gcr);
+    MIPSGCRVPState *current_vps = &gcr->vps[cur];
     MIPSGCRVPState *other_vps = &gcr->vps[current_vps->other];
 
     switch (addr) {
     /* Global Control Block Register */
     case GCR_CONFIG_OFS:
-        /* Set PCORES to 0 */
-        return 0;
+        /* PCORES: cores - 1 (VP-based: 0) */
+        return gcr->vp_per_core ? gcr->num_vps / gcr->vp_per_core - 1 : 0;
     case GCR_BASE_OFS:
         return gcr->gcr_base;
     case GCR_REV_OFS:
@@ -99,8 +135,8 @@ static uint64_t gcr_read(void *opaque, hwaddr addr, unsigned size)
         /* Core-Local and Core-Other Control Blocks */
     case MIPS_CLCB_OFS + GCR_CL_CONFIG_OFS:
     case MIPS_COCB_OFS + GCR_CL_CONFIG_OFS:
-        /* Set PVP to # of VPs - 1 */
-        return gcr->num_vps - 1;
+        /* Set PVP to # of VPs - 1 (MT cores: PVPE, VPEs of the core - 1) */
+        return gcr->vp_per_core ? gcr->vp_per_core - 1 : gcr->num_vps - 1;
     case MIPS_CLCB_OFS + GCR_CL_COHERENCE_OFS:
         return current_vps->coherence;
     case MIPS_COCB_OFS + GCR_CL_COHERENCE_OFS:
@@ -110,9 +146,14 @@ static uint64_t gcr_read(void *opaque, hwaddr addr, unsigned size)
     case MIPS_COCB_OFS + GCR_CL_RESETBASE_OFS:
         return other_vps->reset_base;
