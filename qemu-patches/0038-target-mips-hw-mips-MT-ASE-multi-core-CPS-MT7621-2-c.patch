 }
 
+/* the pins of a VP's local interrupts, after a change of their state */
+static void gic_update_vp_local(MIPSGICState *gic, int vp)
+{
+    if (gic->vps[vp].compare_map & GIC_MAP_TO_PIN_MSK) {
+        mips_gic_set_vp_irq(gic, vp, gic->vps[vp].compare_map & GIC_MAP_MSK);
+    }
+    if (gic->timer_routable && (gic->vps[vp].timer_map & GIC_MAP_TO_PIN_MSK)) {
+        mips_gic_set_vp_irq(gic, vp, gic->vps[vp].timer_map & GIC_MAP_MSK);
+    }
+}
+
+/* input: the CP0 timer interrupt of VP n */
+static void gic_cpu_timer(void *opaque, int vp, int level)
+{
+    MIPSGICState *gic = opaque;
+
+    if (level) {
+        gic->vps[vp].pend |= 1 << GIC_LOCAL_INT_TIMER;
+    } else {
+        gic->vps[vp].pend &= ~(1 << GIC_LOCAL_INT_TIMER);
+    }
+    gic_update_vp_local(gic, vp);
+}
+
 static void gic_timer_expire_cb(void *opaque, uint32_t vp_index)
 {
     MIPSGICState *gic = opaque;
@@ -231,9 +264,27 @@ static void gic_write_vp(MIPSGICState *gic, uint32_t vp_index, hwaddr addr,
     case GIC_VP_RMASK_OFS:
         gic->vps[vp_index].mask &= ~(data & GIC_VP_SET_RESET_MSK) &
                                    GIC_VP_SET_RESET_MSK;
+        if (gic->timer_routable) {
+            gic_update_vp_local(gic, vp_index);
+        }
         break;
     case GIC_VP_SMASK_OFS:
         gic->vps[vp_index].mask |= data & GIC_VP_SET_RESET_MSK;
+        if (gic->timer_routable) {
+            gic_update_vp_local(gic, vp_index);
+        }
+        break;
+    case GIC_VP_TIMER_MAP_OFS:
+        if (gic->timer_routable) {
+            uint32_t old = gic->vps[vp_index].timer_map;
+
+            OFFSET_CHECK((data & GIC_MAP_MSK) <= GIC_CPU_INT_MAX);
+            gic->vps[vp_index].timer_map = data & GIC_MAP_TO_PIN_REG_MSK;
+            if (old & GIC_MAP_TO_PIN_MSK) {     /* the pin it left */
+                mips_gic_set_vp_irq(gic, vp_index, old & GIC_MAP_MSK);
+            }
+            gic_update_vp_local(gic, vp_index);
+        }
         break;
     case GIC_VP_COMPARE_MAP_OFS:
         /* EIC isn't supported */
@@ -363,7 +414,9 @@ static void gic_reset(void *opaque)
                      (numintrs     << GIC_SH_CONFIG_NUMINTRS_SHF)  |
                      (gic->num_vps << GIC_SH_CONFIG_PVPS_SHF);
     for (i = 0; i < gic->num_vps; i++) {
-        gic->vps[i].ctl         = 0x0;
+        /* Vx_CTL: TIMER_ROUTABLE (bit 1) when the CP0 timers are inputs */
