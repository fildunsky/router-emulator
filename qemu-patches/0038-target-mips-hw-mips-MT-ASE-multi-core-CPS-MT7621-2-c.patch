 }
 
 /* Read GCR registers */
+/* the core-local block of the running CPU: its VP's, or its core's */
+static int gcr_current(MIPSGCRState *gcr)
+{
+    return gcr->vp_per_core ? current_cpu->cpu_index / gcr->vp_per_core
+                            : current_cpu->cpu_index;
+}
+
+/* Cx_OTHER: the VP (VP-based), or the core (CM2 CoreNum, bits 31:16) */
+static void gcr_set_other(MIPSGCRState *gcr, MIPSGCRVPState *vps,
+                          uint64_t data)
+{
+    if (gcr->vp_per_core) {
+        uint32_t core = (data >> 16) & 0xffff;
+
+        if (core < gcr->num_vps / gcr->vp_per_core) {
+            vps->other = core;
+        }
+    } else if ((data & GCR_CL_OTHER_MSK) < gcr->num_vps) {
+        vps->other = data & GCR_CL_OTHER_MSK;
+    }
+}
+
+/* a core's reset base applies to all its VPs */
+static void gcr_set_exception_base(MIPSGCRState *gcr, int idx,
+                                   target_ulong base)
+{
+    if (!gcr->vp_per_core) {
+        cpu_set_exception_base(idx, base);
+        return;
+    }
+    for (int v = 0; v < gcr->vp_per_core; v++) {
+        cpu_set_exception_base(idx * gcr->vp_per_core + v, base);
+    }
+}
+
