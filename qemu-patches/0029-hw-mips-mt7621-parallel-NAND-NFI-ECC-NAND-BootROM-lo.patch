     object_class_property_set_description(oc, "ports",
diff --git a/hw/mips/mt7621_nand.c b/hw/mips/mt7621_nand.c
new file mode 100644
index 0000000..14dbd4d
--- /dev/null
+++ b/hw/mips/mt7621_nand.c
@@ -0,0 +1,642 @@
+/*
+ * MediaTek MT7621 NAND flash interface (NFI + ECC engine, PIO mode) with a
+ * parallel SLC NAND chip behind it (default: 128 MiB, 2048 + 64 bytes per
+ * page, 64 pages per block, ID ec f1 00 95 40 = Samsung K9F1G08U0D).
+ *
+ * The chip sees its pages in the NFI's sector format: per 512-byte sector
+ * 512 data bytes and 16 spare bytes (8 FDM + ECC parity), i.e. raw column
+ * c is data[(c / 528) * 512 + c % 528] for c % 528 < 512, else spare.  The
+ * model keeps data and spare apart (data = what a "cat /dev/mtdN" dump
+ * holds), so partition dumps without OOB are the backing store.
+ *
+ * NFI: commands (CMD), address cycles (COLADDR/ROWADDR/ADDRNOB), data by
+ * PIO (DATAR/DATAW, 1 or 4 bytes); with AUTO_FMT the spare bytes of each
+ * sector go to / come from FDM registers; the ECC decoder reports every
+ * sector done without errors, the encoder writes 0xff parity.  Everything
+ * completes at once (never busy).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "mt7621_nand.h"
+
+/* NFI registers */
+#define NFI_CNFG        0x000
+#define  CNFG_AUTO_FMT  BIT(9)
+#define  CNFG_HW_ECC    BIT(8)
+#define  CNFG_BYTE_RW   BIT(6)
+#define  CNFG_READ_MODE BIT(1)
+#define NFI_PAGEFMT     0x004
+#define NFI_CON         0x008
+#define  CON_NFI_RST    BIT(1)
+#define NFI_CMD         0x020
+#define NFI_ADDRNOB     0x030
+#define NFI_COLADDR     0x034
+#define NFI_ROWADDR     0x038
+#define NFI_STRDATA     0x040
+#define NFI_DATAW       0x050
+#define NFI_DATAR       0x054
+#define NFI_PIO_DIRDY   0x058
+#define NFI_STA         0x060
+#define NFI_ADDRCNTR    0x070
+#define NFI_FDML(n)     (0x0a0 + (n) * 8)
+#define NFI_FDMM(n)     (0x0a4 + (n) * 8)
+#define NFI_MASTER_STA  0x210
+
+/* ECC registers */
+#define ECC_ENCIDLE     0x00c
+#define ECC_DECCON      0x100
+#define ECC_DECIDLE     0x10c
+#define ECC_DECENUM     0x114
+#define ECC_DECDONE     0x118
+
+#define SECT            512
+#define SPARE           16      /* spare bytes per sector (64 / 4) */
+#define FSM_CUSTOM_DATA 14
+
+typedef struct NandSegment {
+    char *path;
+    uint64_t start;
+    uint64_t len;
+    int fd;
+} NandSegment;
+
+struct MT7621NandState {
+    SysBusDevice parent_obj;
+    MemoryRegion nfi_mr, ecc_mr;
+
+    char *dir;
+    char *id_hex;               /* READ ID bytes, hex (default ecf1009540) */
+    uint8_t chip_id[8];
+    int id_len;
+    uint32_t size_mb;
+    NandSegment *segs;
+    int nsegs;
+    uint8_t *data;              /* page_size bytes per page */
+    uint8_t *oob;               /* 64 bytes per page */
+    uint32_t pages;
+
+    /* NFI */
+    uint32_t nfi[0x800 / 4];
+    uint32_t ecc[0x800 / 4];
+    bool data_phase;
+    uint32_t sec_pos;           /* byte index in the current sector */
+    uint32_t sec;               /* current sector */
+
+    /* chip */
+    uint8_t cmd;
+    uint8_t addr[5];
+    int naddr;
+    uint32_t page;              /* row of the last READ / PROGRAM */
+    uint32_t col;               /* raw column */
+    uint8_t buf[2048 + 64];     /* page register (raw sector format) */
+    bool id_mode, status_mode;
+    uint32_t id_pos;
+};
+
+
+#define PAGE_SIZE_      2048
+#define OOB_SIZE        64
+#define RAW_PAGE        (PAGE_SIZE_ + OOB_SIZE)
+#define PAGES_PER_BLOCK 64
+
+/* raw column (sector format) -> pointer into a data[2048] + oob[64] pair */
+static uint8_t *raw_ptr(uint8_t *data, uint8_t *oob, uint32_t col)
+{
+    uint32_t s = col / (SECT + SPARE), o = col % (SECT + SPARE);
+
+    if (s >= 4) {
+        return NULL;
+    }
+    return o < SECT ? &data[s * SECT + o] : &oob[s * SPARE + o - SECT];
+}
+
+/* page register <-> storage */
+static void page_load(MT7621NandState *s, uint32_t page)
+{
+    for (uint32_t c = 0; c < RAW_PAGE; c++) {
+        uint8_t *p = page < s->pages ?
+            raw_ptr(s->data + (uint64_t)page * PAGE_SIZE_,
+                    s->oob + (uint64_t)page * OOB_SIZE, c) : NULL;
+        s->buf[c] = p ? *p : 0xff;
+    }
+}
+
+static ssize_t file_pwrite(int fd, const void *buf, size_t len, off_t off)
+{
+    if (lseek(fd, off, SEEK_SET) != off) {
+        return -1;
+    }
+    return write(fd, buf, len);
+}
+
+static ssize_t file_pread(int fd, void *buf, size_t len, off_t off)
+{
+    if (lseek(fd, off, SEEK_SET) != off) {
+        return -1;
+    }
+    return read(fd, buf, len);
+}
+
+/* the data of page back to the dump files */
+static void flush_page(MT7621NandState *s, uint32_t page)
+{
+    uint64_t loff = (uint64_t)page * PAGE_SIZE_;
+    uint8_t *src = s->data + loff;
+
+    for (int i = 0; i < s->nsegs; i++) {
+        NandSegment *g = &s->segs[i];
+        uint64_t a = MAX(loff, g->start);
+        uint64_t b = MIN(loff + PAGE_SIZE_, g->start + g->len);
+
+        if (a < b && g->fd >= 0 &&
+            file_pwrite(g->fd, src + (a - loff), b - a, a - g->start) !=
+            (ssize_t)(b - a)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "mt7621-nand: write to %s "
+                          "failed\n", g->path);
+        }
+    }
+}
+
+static void page_program(MT7621NandState *s)
+{
+    uint32_t page = s->page;
+
+    if (page >= s->pages) {
+        return;
+    }
+    for (uint32_t c = 0; c < RAW_PAGE; c++) {
+        uint8_t *p = raw_ptr(s->data + (uint64_t)page * PAGE_SIZE_,
+                             s->oob + (uint64_t)page * OOB_SIZE, c);
+        if (p) {
+            *p &= s->buf[c];    /* NAND programming only clears bits */
+        }
+    }
+    flush_page(s, page);
+}
+
+static void block_erase(MT7621NandState *s, uint32_t row)
+{
+    uint32_t first = row & ~(PAGES_PER_BLOCK - 1);
+
+    for (uint32_t p = first; p < first + PAGES_PER_BLOCK && p < s->pages;
+         p++) {
+        memset(s->data + (uint64_t)p * PAGE_SIZE_, 0xff, PAGE_SIZE_);
+        memset(s->oob + (uint64_t)p * OOB_SIZE, 0xff, OOB_SIZE);
+        flush_page(s, p);
+    }
+}
+
+static uint32_t addr_row(MT7621NandState *s, int from)
+{
+    uint32_t r = 0;
+
+    for (int i = from; i < s->naddr && i < from + 3; i++) {
+        r |= s->addr[i] << (8 * (i - from));
+    }
+    return r;
+}
+
+static void chip_command(MT7621NandState *s, uint8_t cmd)
+{
+    switch (cmd) {
+    case 0xff:                  /* RESET */
+        s->id_mode = s->status_mode = false;
+        s->cmd = 0;
+        return;
+    case 0x90:                  /* READ ID */
+    case 0x70:                  /* READ STATUS */
+    case 0x00: case 0x05: case 0x80: case 0x85: case 0x60: case 0xec:
+        s->cmd = cmd;
+        s->naddr = 0;
+        s->id_mode = cmd == 0x90;
+        s->status_mode = cmd == 0x70;
+        s->id_pos = 0;
+        if (cmd == 0x80) {
+            memset(s->buf, 0xff, sizeof(s->buf));
+        }
+        return;
+    case 0x30:                  /* READ confirm */
+        s->page = addr_row(s, 2);
+        s->col = s->addr[0] | (s->addr[1] << 8);
+        page_load(s, s->page);
+        s->cmd = 0x30;
+        return;
+    case 0xe0:                  /* random data out confirm */
+        s->col = s->addr[0] | (s->addr[1] << 8);
+        s->cmd = 0x30;
+        return;
+    case 0x10:                  /* PROGRAM confirm */
+        page_program(s);
+        s->cmd = 0;
+        return;
+    case 0xd0:                  /* ERASE confirm */
+        block_erase(s, addr_row(s, 0));
+        s->cmd = 0;
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP, "mt7621-nand: command 0x%02x\n", cmd);
+}
+
+static void chip_address(MT7621NandState *s, uint8_t a)
+{
+    if (s->naddr < ARRAY_SIZE(s->addr)) {
+        s->addr[s->naddr++] = a;
+    }
+    if (s->cmd == 0x80 && s->naddr >= 2) {
+        s->page = addr_row(s, 2);
+        s->col = s->addr[0] | (s->addr[1] << 8);
+    } else if (s->cmd == 0x85 && s->naddr >= 2) {
+        s->col = s->addr[0] | (s->addr[1] << 8);
+    }
+}
+
+static uint8_t chip_read(MT7621NandState *s)
+{
+    if (s->id_mode) {
+        if (s->addr[0] == 0x20) {   /* ONFI signature: not ONFI */
+            return 0x00;
+        }
+        return s->id_pos < s->id_len ? s->chip_id[s->id_pos++] : 0x00;
+    }
+    if (s->status_mode) {
+        return 0xe0;                /* ready, not write protected */
+    }
+    if (s->col < RAW_PAGE) {
+        return s->buf[s->col++];
+    }
+    return 0xff;
+}
+
+static void chip_write(MT7621NandState *s, uint8_t v)
+{
+    if (s->col < RAW_PAGE) {
+        s->buf[s->col++] = v;
+    }
+}
+
+/*
+ * One byte of the data phase through the NFI: with AUTO_FMT the spare
+ * bytes of each sector are taken from / given to the FDM registers.
+ */
+static void fmt_after_sector(MT7621NandState *s, bool rd)
+{
+    uint32_t cnfg = s->nfi[NFI_CNFG / 4];
+    uint8_t spare[SPARE];
+
+    if (rd) {
+        for (int i = 0; i < SPARE; i++) {
+            spare[i] = chip_read(s);
+        }
+        if (s->sec < 8) {
+            s->nfi[NFI_FDML(s->sec) / 4] = ldl_le_p(spare);
+            s->nfi[NFI_FDMM(s->sec) / 4] = ldl_le_p(spare + 4);
+        }
+        if (cnfg & CNFG_HW_ECC) {
+            s->ecc[ECC_DECDONE / 4] |= 1u << s->sec;
+        }
+    } else {
+        memset(spare, 0xff, sizeof(spare));
+        if (s->sec < 8) {
+            stl_le_p(spare, s->nfi[NFI_FDML(s->sec) / 4]);
+            stl_le_p(spare + 4, s->nfi[NFI_FDMM(s->sec) / 4]);
+        }
+        for (int i = 0; i < SPARE; i++) {
+            chip_write(s, spare[i]);
+        }
+    }
+    s->sec++;
+    s->sec_pos = 0;
+}
+
+static uint8_t nfi_read_byte(MT7621NandState *s)
+{
+    uint8_t v = chip_read(s);
+
+    if (s->nfi[NFI_CNFG / 4] & CNFG_AUTO_FMT && ++s->sec_pos == SECT) {
+        fmt_after_sector(s, true);
+    }
+    return v;
+}
+
+static void nfi_write_byte(MT7621NandState *s, uint8_t v)
+{
+    chip_write(s, v);
+    if (s->nfi[NFI_CNFG / 4] & CNFG_AUTO_FMT && ++s->sec_pos == SECT) {
+        fmt_after_sector(s, false);
+    }
+}
+
+static void nfi_reset(MT7621NandState *s)
+{
+    s->data_phase = false;
+    s->sec = s->sec_pos = 0;
+    s->nfi[NFI_STRDATA / 4] = 0;
+}
+
+static uint64_t nfi_read(void *opaque, hwaddr a, unsigned size)
+{
+    MT7621NandState *s = opaque;
+    uint32_t v = 0;
+
+    switch (a & ~3) {
+    case NFI_DATAR:
+        if (s->nfi[NFI_CNFG / 4] & CNFG_BYTE_RW) {
+            return nfi_read_byte(s);
+        }
+        for (int i = 0; i < 4; i++) {
+            v |= nfi_read_byte(s) << (8 * i);
+        }
+        return v;
+    case NFI_PIO_DIRDY:
+        return 1;
+    case NFI_STA:
+        /* never busy; data phase: FSM "custom data" */
+        return s->data_phase ? FSM_CUSTOM_DATA << 16 : 0;
+    case NFI_ADDRCNTR:
+        return (MIN(s->sec, 15) << 12) | (s->sec_pos & 0x3ff);
+    case NFI_MASTER_STA:
+        return 0;
+    }
+    v = s->nfi[(a & 0x7ff) / 4];
+    return v >> ((a & 3) * 8);
+}
+
+static void nfi_write(void *opaque, hwaddr a, uint64_t val, unsigned size)
+{
+    MT7621NandState *s = opaque;
+    uint32_t v = val;
+
+    switch (a & ~3) {
+    case NFI_CMD:
+        chip_command(s, v);
+        return;
+    case NFI_ADDRNOB: {
+        int ncol = v & 7, nrow = (v >> 4) & 7;
+        for (int i = 0; i < ncol; i++) {
+            chip_address(s, s->nfi[NFI_COLADDR / 4] >> (8 * i));
+        }
+        for (int i = 0; i < nrow; i++) {
+            chip_address(s, s->nfi[NFI_ROWADDR / 4] >> (8 * i));
+        }
+        return;
+    }
+    case NFI_CON:
+        if (v & CON_NFI_RST) {
+            nfi_reset(s);
+        }
+        break;
+    case NFI_STRDATA:
+        if (v & 1) {
+            s->data_phase = true;
+        }
+        break;
+    case NFI_DATAW:
+        if (s->nfi[NFI_CNFG / 4] & CNFG_BYTE_RW) {
+            nfi_write_byte(s, v);
+        } else {
+            for (int i = 0; i < 4; i++) {
+                nfi_write_byte(s, v >> (8 * i));
+            }
+        }
+        return;
+    case NFI_CNFG:
+        /* a new operation: sector counters from the start */
+        s->sec = s->sec_pos = 0;
+        break;
+    }
+    if (size == 4) {
+        s->nfi[(a & 0x7ff) / 4] = v;
+    } else {
+        uint32_t *r = &s->nfi[(a & 0x7ff) / 4];
+        unsigned sh = (a & 3) * 8;
+        uint32_t m = ((1u << (size * 8)) - 1) << sh;
+        *r = (*r & ~m) | ((v << sh) & m);
+    }
+}
+
+static const MemoryRegionOps nfi_ops = {
+    .read = nfi_read,
+    .write = nfi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static uint64_t ecc_read(void *opaque, hwaddr a, unsigned size)
+{
+    MT7621NandState *s = opaque;
+    uint32_t v;
+
+    switch (a & ~3) {
+    case ECC_ENCIDLE:
+    case ECC_DECIDLE:
+        v = 3;
+        break;
+    case ECC_DECENUM:
+        v = 0;                  /* no bit errors */
+        break;
+    default:
+        v = s->ecc[(a & 0x7ff) / 4];
+    }
+    return v >> ((a & 3) * 8);
+}
+
+static void ecc_write(void *opaque, hwaddr a, uint64_t val, unsigned size)
+{
+    MT7621NandState *s = opaque;
+
+    if ((a & ~3) == ECC_DECCON) {
+        s->ecc[ECC_DECDONE / 4] = 0;    /* decoder (re)started */
+    }
+    s->ecc[(a & 0x7ff) / 4] = val;
+}
+
+static const MemoryRegionOps ecc_ops = {
+    .read = ecc_read,
+    .write = ecc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+void mt7621_nand_read(MT7621NandState *s, uint64_t off, void *buf,
+                      size_t len)
+{
+    uint64_t total = (uint64_t)s->pages * PAGE_SIZE_;
+
+    if (off >= total) {
+        memset(buf, 0xff, len);
+        return;
+    }
+    memcpy(buf, s->data + off, MIN(len, total - off));
+    if (len > total - off) {
+        memset((uint8_t *)buf + (total - off), 0xff, len - (total - off));
+    }
+}
+
+static int seg_cmp(const void *a, const void *b)
+{
+    const NandSegment *x = a, *y = b;
+    return (int)x->start - (int)y->start;   /* the mtd index here */
+}
+
+/*
+ * Partition dumps: every file whose name contains "mtdN", in mtd order,
+ * concatenated (data only, no OOB); the rest of the chip is erased.
+ */
+static bool load_dir(MT7621NandState *s, Error **errp)
+{
+    GDir *d = g_dir_open(s->dir, 0, NULL);
+    GRegex *re = g_regex_new("mtd([0-9]+)", 0, 0, NULL);
+    uint64_t total = (uint64_t)s->pages * PAGE_SIZE_, pos = 0;
+    const char *name;
+
+    if (!d) {
+        error_setg(errp, "mt7621-nand: cannot open NAND directory '%s'",
+                   s->dir);
+        return false;
+    }
+    while ((name = g_dir_read_name(d))) {
+        GMatchInfo *mi;
+        if (g_regex_match(re, name, 0, &mi)) {
+            g_autofree char *num = g_match_info_fetch(mi, 1);
+            s->segs = g_renew(NandSegment, s->segs, s->nsegs + 1);
+            s->segs[s->nsegs].path = g_build_filename(s->dir, name, NULL);
+            s->segs[s->nsegs].start = atoi(num);
+            s->segs[s->nsegs].fd = -1;
+            s->nsegs++;
+        }
+        g_match_info_free(mi);
+    }
+    g_dir_close(d);
+    g_regex_unref(re);
+    if (!s->nsegs) {
+        error_setg(errp, "mt7621-nand: no *mtdN* files in '%s'", s->dir);
+        return false;
+    }
+    qsort(s->segs, s->nsegs, sizeof(NandSegment), seg_cmp);
+    for (int i = 0; i < s->nsegs; i++) {
+        NandSegment *g = &s->segs[i];
+        struct stat st;
+
+        if (i && g->start == s->segs[i - 1].start) {
+            error_setg(errp, "mt7621-nand: two files for mtd%d: %s and %s",
+                       (int)g->start, s->segs[i - 1].path, g->path);
+            return false;
+        }
+        g->fd = open(g->path, O_RDWR | O_BINARY);
+        if (g->fd < 0) {
+            g->fd = open(g->path, O_RDONLY | O_BINARY);
+            warn_report("mt7621-nand: %s is read-only, writes are not "
+                        "saved", g->path);
+        }
+        if (g->fd < 0 || fstat(g->fd, &st) < 0) {
+            error_setg_errno(errp, errno, "mt7621-nand: cannot open %s",
+                             g->path);
+            return false;
+        }
+        g->start = pos;
+        g->len = st.st_size;
+        if (pos + g->len > total) {
+            error_setg(errp, "mt7621-nand: partition files exceed the flash "
+                       "size (%" PRIu64 " bytes) at %s", total, g->path);
+            return false;
+        }
+        if (file_pread(g->fd, s->data + pos, g->len, 0) != (ssize_t)g->len) {
+            error_setg(errp, "mt7621-nand: read error on %s", g->path);
+            return false;
+        }
+        info_report("NAND 0x%08" PRIx64 "-0x%08" PRIx64 ": %s", pos,
+                    pos + g->len, g->path);
+        pos += g->len;
+    }
+    return true;
+}
+
+static void mt7621_nand_realize(DeviceState *dev, Error **errp)
+{
+    MT7621NandState *s = MT7621_NAND(dev);
+    uint64_t size = (uint64_t)s->size_mb * MiB;
+
+    const char *id = s->id_hex ? s->id_hex : "ecf1009540";
+
+    s->id_len = 0;
+    for (; id[0] && id[1] && s->id_len < (int)sizeof(s->chip_id); id += 2) {
+        unsigned v;
+        if (sscanf(id, "%2x", &v) != 1) {
+            error_setg(errp, "mt7621-nand: id must be hex bytes");
+            return;
+        }
+        s->chip_id[s->id_len++] = v;
+    }
+    s->pages = size / PAGE_SIZE_;
+    s->data = g_malloc(size);
+    s->oob = g_malloc((uint64_t)s->pages * OOB_SIZE);
+    memset(s->data, 0xff, size);
+    memset(s->oob, 0xff, (uint64_t)s->pages * OOB_SIZE);
+    if (s->dir) {
+        load_dir(s, errp);
+    }
+}
+
+static void mt7621_nand_reset(DeviceState *dev)
+{
+    MT7621NandState *s = MT7621_NAND(dev);
+
+    memset(s->nfi, 0, sizeof(s->nfi));
+    memset(s->ecc, 0, sizeof(s->ecc));
+    nfi_reset(s);
+    s->cmd = 0;
+    s->naddr = 0;
+    s->id_mode = s->status_mode = false;
+}
+
+static void mt7621_nand_init(Object *obj)
+{
+    MT7621NandState *s = MT7621_NAND(obj);
+
+    memory_region_init_io(&s->nfi_mr, obj, &nfi_ops, s, "mt7621-nfi", 0x800);
+    memory_region_init_io(&s->ecc_mr, obj, &ecc_ops, s, "mt7621-nfi-ecc",
+                          0x800);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->nfi_mr);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->ecc_mr);
+}
+
+static const Property mt7621_nand_props[] = {
+    DEFINE_PROP_STRING("dir", MT7621NandState, dir),
+    DEFINE_PROP_STRING("id", MT7621NandState, id_hex),
+    DEFINE_PROP_UINT32("size-mb", MT7621NandState, size_mb, 128),
+};
+
+static void mt7621_nand_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = mt7621_nand_realize;
+    device_class_set_legacy_reset(dc, mt7621_nand_reset);
+    device_class_set_props(dc, mt7621_nand_props);
+    dc->desc = "MT7621 NFI + parallel SLC NAND";
+}
+
+static const TypeInfo mt7621_nand_type = {
+    .name = TYPE_MT7621_NAND,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MT7621NandState),
+    .instance_init = mt7621_nand_init,
+    .class_init = mt7621_nand_class_init,
+};
+
+static void mt7621_nand_register(void)
+{
+    type_register_static(&mt7621_nand_type);
+}
+
+type_init(mt7621_nand_register)
