 /*
- * CACHE instructions.  The TPL locks lines of the L2 cache and fills
- * them (Index Store Tag / Index Store Data, secondary cache) to run the
- * SPL from the cache before the DRAM works.  There is no cache here and
- * the DRAM always works, so the data goes straight to the memory behind
- * the line.
+ * L2 cache locked as SRAM.  Before the DRAM works, the boot code (U-Boot's
+ * TPL, Breed) locks L2 lines (Index Store Tag, STagLo lock bit) and fills
+ * them (Index Store Data) to run from them through kseg0, while the DDR
+ * init's memory tests write the same addresses uncached through kseg1.
+ * Locked lines are kept apart from the DRAM: the pages holding them are
+ * copied to an overlay that cached accesses see; unlocking (Index Store
+ * Tag 0, the cache reset) drops the overlay, the data of locked lines is
+ * not written back, like on the hardware.
  */
+static int l2_find(MT7621Board *b, uint32_t page)
+{
+    for (int i = 0; i < b->l2_npages; i++) {
+        if (b->l2_page[i] == page) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void l2_flush_tlbs(void)
+{
+    CPUState *cs;
+
+    CPU_FOREACH(cs) {
+        tlb_flush(cs);
+    }
+}
+
+static hwaddr mt7621_kseg0_remap(CPUMIPSState *env, hwaddr pa)
+{
+    MT7621Board *b = the_board;
+    int i = b->l2_npages ? l2_find(b, pa >> 12) : -1;
+
+    return i < 0 ? pa : L2_OVL_BASE + ((hwaddr)i << 12) + (pa & 0xfff);
+}
+
+static void l2_lock(MT7621Board *b, hwaddr pa)
+{
+    uint32_t page = pa >> 12;
+    uint8_t buf[4096];
+
+    if (l2_find(b, page) >= 0) {
+        return;
+    }
+    if (b->l2_npages == L2_OVL_PAGES) {
+        qemu_log_mask(LOG_UNIMP, "mt7621: too many locked L2 pages\n");
+        return;
+    }
+    /* the line's page as it is in the DRAM (the rest of the page) */
+    address_space_read(&address_space_memory, (hwaddr)page << 12,
+                       MEMTXATTRS_UNSPECIFIED, buf, sizeof(buf));
+    qemu_log_mask(LOG_UNIMP, "mt7621: L2 lock page 0x%08x\n", page << 12);
+    b->l2_page[b->l2_npages] = page;
+    address_space_write(&address_space_memory,
+                        L2_OVL_BASE + ((hwaddr)b->l2_npages << 12),
+                        MEMTXATTRS_UNSPECIFIED, buf, sizeof(buf));
+    b->l2_npages++;
+    l2_flush_tlbs();
+}
+
 static void mt7621_cache_hook(CPUMIPSState *env, target_ulong addr,
                               uint32_t op)
 {
-    if (op == 0x0f) {   /* Index Store Data, secondary cache */
+    MT7621Board *b = the_board;
+
+    if (op == 0x0b) {           /* Index Store Tag, secondary cache */
+        uint32_t tag = env->CP0_TagLo;
+
+        if (tag & 0x20) {       /* lock */
+            l2_lock(b, (tag & 0x1ffff800) | (addr & 0x7e0));
+        } else if (!tag && b->l2_npages) {
+            qemu_log_mask(LOG_UNIMP, "mt7621: L2 unlocked\n");
+            b->l2_npages = 0;   /* cache reset: everything unlocked */
+            l2_flush_tlbs();
+        }
+    } else if (op == 0x0f) {    /* Index Store Data, secondary cache */
         uint32_t d[2] = { cpu_to_le32(env->CP0_DataLo),
                           cpu_to_le32(env->CP0_DataHi) };
 
-        address_space_write(&address_space_memory, addr & 0x1ffffff8,
+        address_space_write(&address_space_memory,
+                            mt7621_kseg0_remap(env, addr & 0x1ffffff8),
                             MEMTXATTRS_UNSPECIFIED, d, sizeof(d));
     }
 }
 
+/*
+ * BootROM, NAND boot (high level).  Page 0 holds a legacy uImage header
+ * whose name field is MediaTek's NAND header (stage offset at 0x30); the
+ * stage starts with a header of its own (big endian: entry point at +8,
+ * size at +0xc).
+ *  1. the stage is copied into locked L2 lines at its entry point and
+ *     called (jalr, stack in the FE SRAM); it keeps the return address
+ *     and stack at 0xbe10ad00, initialises the DDR and returns
+ *  2. back in the BootROM, the bootloader (from the NAND header's
+ *     bootloader offset, 0x34, to the end of the uImage data) is copied to
+ *     the uImage load address in DRAM, 0x7621abcd is stored at 0xbe10ad00
+ *     ("DRAM is up") and the uImage entry point is called.
+ * A stub at the reset vector does the jumps; it calls back into the model
+ * for step 2 by a write to BROM_TRIG.
+ */
+#define BROM_TRIG       0xf00
+#define BROM_MAILBOX    0x1e10ad00ULL
+#define BROM_MAGIC      0x7621abcd
+
+static void brom_stub_jump(uint32_t *p, uint32_t to)
+
+{
+    p[0] = cpu_to_le32(0x3c190000 | (to >> 16));        /* lui t9 */
+    p[1] = cpu_to_le32(0x37390000 | (to & 0xffff));     /* ori t9 */
+    p[2] = cpu_to_le32(0x03200008);                     /* jr t9 */
+    p[3] = 0;                                           /* nop */
+}
+
+static void mt7621_brom_nand(MT7621Board *b)
+{
+    uint8_t hdr[0x40], sh[0x10];
+    uint32_t stage_off, ep, size, mbox[2];
+    uint32_t *stub = memory_region_get_ram_ptr(&b->brom);
+    g_autofree uint8_t *stage = NULL;
+
+    mt7621_nand_read(b->nand, 0, hdr, sizeof(hdr));
+    if (ldl_be_p(hdr) != 0x27051956) {
+        error_report("NAND boot: no image header (uImage magic) at 0");
+        return;
+    }
+    stage_off = ldl_be_p(hdr + 0x30);
+    mt7621_nand_read(b->nand, stage_off, sh, sizeof(sh));
+    ep = ldl_be_p(sh + 8);
+    size = ldl_be_p(sh + 12);
+    if (!size || size > 0x40000 || (ep >> 29) != 4) {
+        error_report("NAND boot: bad stage header (entry 0x%08x, size "
+                     "0x%x)", ep, size);
+        return;
+    }
+    stage = g_malloc(size);
+    mt7621_nand_read(b->nand, stage_off, stage, size);
+    for (uint32_t o = 0; o < size; o += 4096) {
+        l2_lock(b, ((ep & 0x1fffffff) + o) & ~0xfffu);
+    }
+    for (uint32_t o = 0; o < size; o += 4) {
+        address_space_write(&address_space_memory,
+                            mt7621_kseg0_remap(NULL, (ep & 0x1fffffff) + o),
+                            MEMTXATTRS_UNSPECIFIED, stage + o, 4);
+    }
+    mbox[0] = mbox[1] = 0;
+    address_space_write(&address_space_memory, BROM_MAILBOX,
+                        MEMTXATTRS_UNSPECIFIED, mbox, sizeof(mbox));
+
+    memset(stub, 0, 0x1000);
+    stub[0] = cpu_to_le32(0x3c1dbe10);              /* lui sp, 0xbe10 */
+    stub[1] = cpu_to_le32(0x37bddff0);              /* ori sp, 0xdff0 */
+    stub[2] = cpu_to_le32(0x3c190000 | (ep >> 16)); /* lui t9 */
+    stub[3] = cpu_to_le32(0x37390000 | (ep & 0xffff)); /* ori t9 */
+    stub[4] = cpu_to_le32(0x0320f809);              /* jalr t9 */
+    stub[5] = 0;
+    /* back from the stage: step 2 in the model, then the image */
+    stub[6] = cpu_to_le32(0x3c08bfc0);              /* lui t0, 0xbfc0 */
+    stub[7] = cpu_to_le32(0xad000000 | BROM_TRIG);  /* sw zero, TRIG(t0) */
+    brom_stub_jump(stub + 8, ldl_be_p(hdr + 0x14));
+}
+
+/* step 2: the bootloader to its load address, "DRAM is up" */
+static void brom_trig_write(void *opaque, hwaddr a, uint64_t v, unsigned sz)
+{
+    MT7621Board *b = opaque;
+    uint8_t hdr[0x40];
+    uint32_t size, load, off, magic = cpu_to_le32(BROM_MAGIC);
+    g_autofree uint8_t *img = NULL;
+
+    mt7621_nand_read(b->nand, 0, hdr, sizeof(hdr));
+    off = ldl_be_p(hdr + 0x34);
+    size = ldl_be_p(hdr + 0x0c) + 0x40;
+    load = ldl_be_p(hdr + 0x10);
+    if (off < 0x40 || off >= size || size > 64 * MiB) {
+        error_report("NAND boot: bad bootloader offset 0x%x / size 0x%x",
+                     off, size);
+        return;
+    }
+    size -= off;
+    img = g_malloc(size);
+    mt7621_nand_read(b->nand, off, img, size);
+    address_space_write(&address_space_memory, load & 0x1fffffff,
+                        MEMTXATTRS_UNSPECIFIED, img, size);
+    address_space_write(&address_space_memory, BROM_MAILBOX,
+                        MEMTXATTRS_UNSPECIFIED, &magic, 4);
+}
+
+static uint64_t brom_trig_read(void *opaque, hwaddr a, unsigned size)
+{
+    return 0;
+}
+
+static const MemoryRegionOps brom_trig_ops = {
+    .read = brom_trig_read,
+    .write = brom_trig_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
 static void mt7621_reset(void *opaque)
 {
-    palmbus_reset(opaque);
+    MT7621Board *b = opaque;
+
+    palmbus_reset(b);
+    b->l2_npages = 0;
+    /*
+     * GIC: local interrupts (compare, timer, ...) masked after reset, as
+     * on the hardware; QEMU's GIC enables the compare one (mapped to pin
+     * 0), which a bootloader not using the GIC timer never clears (Breed)
+     */
+    for (int i = 0; i < b->cps.gic.num_vps; i++) {
+        b->cps.gic.vps[i].mask = 0;
+    }
+    if (b->flash_nand) {
+        mt7621_brom_nand(b);
+    }
 }
 
